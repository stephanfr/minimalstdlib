AArch64 J-block-stamp-llsc-rcpc-control
"block retire / reclaimer stamp / epoch advancer / reader"
{
blocks=1; epoch=1;
0:X0=blocks; 0:X1=list;
1:X1=list; 1:X2=epoch;
2:X2=epoch;
3:X0=blocks; 3:X2=epoch;
}
P0                                 | P1                                 | P2                                 | P3                                 ;
MOV W11,#0                         | LDR W11,[X1]                       | DMB ISH                            | LDAPR W11,[X2]                     ;
LDAXR W12,[X0]                     | LDAPR W12,[X2]                     | MOV W11,#2                         | DMB ISH                            ;
STLXR W13,W11,[X0]                 |                                    | LDAXR W12,[X2]                     | LDAPR W12,[X0]                     ;
MOV W14,#1                         |                                    | STLXR W13,W11,[X2]                 |                                    ;
STR W14,[X1]                       |                                    |                                    |                                    ;
exists (0:X12=1 /\ 0:X13=0 /\ 2:X12=1 /\ 2:X13=0 /\ 1:X11=1 /\ 1:X12=1 /\ 3:X11=2 /\ 3:X12=1)
