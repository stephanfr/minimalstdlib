AArch64 K-iterator-mark-a53-code
"retire mark / epoch advancer / iterator"
{
epoch=1;
0:X0=mark; 0:X2=epoch;
1:X2=epoch;
2:X0=mark; 2:X2=epoch; 2:X3=snap;
}
P0                                 | P1                                 | P2                                 ;
MOV W11,#1                         | DMB ISH                            | LDAR W11,[X2]                      ;
STR W11,[X0]                       | MOV W11,#2                         | MOV W12,#1                         ;
DMB ISH                            | LDAXR W12,[X2]                     | STLR W12,[X3]                      ;
LDAR W12,[X2]                      | STLXR W13,W11,[X2]                 | DMB ISH                            ;
                                   |                                    | LDAR W13,[X0]                      ;
exists (1:X12=1 /\ 1:X13=0 /\ 0:X12=1 /\ 2:X11=2 /\ 2:X13=0)
