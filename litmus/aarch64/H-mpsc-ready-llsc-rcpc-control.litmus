AArch64 H-mpsc-ready-llsc-rcpc-control
"slot publication"
{
0:X0=ready; 0:X1=elem;
1:X0=ready; 1:X1=elem;
}
P0                                 | P1                                 ;
MOV W11,#1                         | LDR W11,[X0]                       ;
STR W11,[X1]                       | LDR W12,[X1]                       ;
MOV W12,#1                         |                                    ;
STR W12,[X0]                       |                                    ;
exists (1:X11=1 /\ 1:X12=0)
