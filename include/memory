#pragma once

#include <stddef.h>

#include <alloca.h>

#include "new"

#include "minstdconfig.h"
#include "utility"

#include "__memory_resource/memory_resource.h"
#include "__type_traits/is_convertible.h"

namespace MINIMAL_STD_NAMESPACE
{

    //
    //  unique_ptr owns an object allocated from a pmr::memory_resource.
    //
    //  The pointer may be converted to a base class (unique_ptr<Derived> -> unique_ptr<Base>).  To make that
    //      safe, the original allocation's address, size, alignment and destructor are captured when the
    //      unique_ptr is created and travel with every move.  Destruction and deallocation always use them,
    //      so the most-derived destructor runs (virtual or not), and the resource is handed back exactly the
    //      pointer, size and alignment it gave out - even when the base is not the first base class.
    //

    template <typename T>
    class unique_ptr
    {
    public:
        explicit unique_ptr()
        {
        }

        explicit unique_ptr(T *pointer_to_wrap, minstd::pmr::memory_resource &resource)
            : wrapped_pointer_(pointer_to_wrap),
              resource_(&resource),
              allocation_((void *)pointer_to_wrap),
              allocation_size_(sizeof(T)),
              allocation_alignment_(alignof(T)),
              destroy_(&destroy_as<T>)
        {
        }

        unique_ptr(const unique_ptr &pointer_to_copy) = delete;

        unique_ptr(unique_ptr &&pointer_to_move)
        {
            take_from(pointer_to_move);
        }

        //  Converting move: U* -> T*, only where U* converts implicitly to T* (e.g. U derived from T).

        template <typename U>
            requires is_convertible_v<U *, T *>
        unique_ptr(unique_ptr<U> &&other)
        {
            take_from(other);
        }

        ~unique_ptr()
        {
            destroy_wrapped_pointer();
        }

        unique_ptr &operator=(const unique_ptr &pointer_to_copy) = delete;

        unique_ptr &operator=(unique_ptr &&pointer_to_move)
        {
            if (this != &pointer_to_move)
            {
                destroy_wrapped_pointer();
                take_from(pointer_to_move);
            }

            return *this;
        }

        //  Converting move assignment: U* -> T*.  Cannot alias *this, since unique_ptr<U> is a different type.

        template <typename U>
            requires is_convertible_v<U *, T *>
        unique_ptr &operator=(unique_ptr<U> &&other)
        {
            destroy_wrapped_pointer();
            take_from(other);

            return *this;
        }

        operator bool() const
        {
            return wrapped_pointer_ != nullptr;
        }

        T &operator*()
        {
            return *wrapped_pointer_;
        }

        const T &operator*() const
        {
            return *wrapped_pointer_;
        }

        T *operator->()
        {
            return wrapped_pointer_;
        }

        const T *operator->() const
        {
            return wrapped_pointer_;
        }

        //  The caller takes ownership of the object; it must be destroyed and freed as the allocated type.

        T *release() noexcept
        {
            T *return_value = wrapped_pointer_;

            wrapped_pointer_ = nullptr;
            allocation_ = nullptr;

            return return_value;
        }

        T *get() const noexcept
        {
            return wrapped_pointer_;
        }

    private:
        template <typename U>
        friend class unique_ptr;

        //  Runs the destructor of the type that was actually allocated

        template <typename V>
        static void destroy_as(void *allocation)
        {
            static_cast<V *>(allocation)->~V();
        }

        //  Takes ownership from another unique_ptr (same type or convertible), leaving it empty

        template <typename U>
        void take_from(unique_ptr<U> &other)
        {
            wrapped_pointer_ = other.wrapped_pointer_; //  implicit U* -> T*, adjusts for base-class offset
            resource_ = other.resource_;
            allocation_ = other.allocation_;
            allocation_size_ = other.allocation_size_;
            allocation_alignment_ = other.allocation_alignment_;
            destroy_ = other.destroy_;

            other.wrapped_pointer_ = nullptr;
            other.allocation_ = nullptr;
        }

        void destroy_wrapped_pointer()
        {
            if (wrapped_pointer_ == nullptr)
            {
                return;
            }

            destroy_(allocation_);

            if (resource_ != nullptr)
            {
                resource_->deallocate(allocation_, allocation_size_, allocation_alignment_);
            }

            wrapped_pointer_ = nullptr;
            allocation_ = nullptr;
        }

        T *wrapped_pointer_ = nullptr;                      //  the pointer handed to callers (may be a base subobject)
        minstd::pmr::memory_resource *resource_ = nullptr;
        void *allocation_ = nullptr;                        //  the address the resource actually returned
        size_t allocation_size_ = 0;                        //  sizeof the allocated (most-derived) type
        size_t allocation_alignment_ = 0;                   //  alignof the allocated type
        void (*destroy_)(void *) = nullptr;                 //  destructor of the allocated type
    };
}   //  namespace MINSTD
