#include "minstdconfig.h"

#include <string.h>

#include <algorithm>
#include <memory>
#include <__memory_resource/memory_resource.h>

namespace MINIMAL_STD_NAMESPACE
{
    template <typename T>
    class buffer
    {
    public:
        virtual ~buffer() = default;

        virtual size_t buffer_size() const = 0;
        virtual size_t size() const = 0;
        virtual size_t space_remaining() const = 0;

        virtual void clear() = 0;

        virtual T &operator[](size_t index) = 0;
        virtual const T &operator[](size_t index) const = 0;

        virtual T *data() = 0;
        virtual const T *data() const = 0;

        virtual size_t append(T element_to_append) = 0;
        virtual size_t append(const T *block_to_append, size_t elements_to_append) = 0;

        virtual void pop_back() = 0;
    };

    template <typename T, size_t SIZE>
    class stack_buffer : public buffer<T>
    {
    public:
        stack_buffer()
            : buffer_size_(SIZE),
              size_(0)
        {
        }

        virtual ~stack_buffer()
        {
        }

        size_t buffer_size() const override
        {
            return buffer_size_;
        }

        size_t size() const override
        {
            return size_;
        }

        size_t space_remaining() const override
        {
            return buffer_size_ - size_;
        }

        void clear() override
        {
            size_ = 0;
        }

        T &operator[](size_t index) override
        {
            return buffer_[index];
        }

        const T &operator[](size_t index) const override
        {
            return buffer_[index];
        }

        T *data() override
        {
            return buffer_;
        }

        const T *data() const override
        {
            return buffer_;
        }

        size_t append(T element_to_append) override
        {
            return append(&element_to_append, 1);
        }

        size_t append(const T *block_to_append, size_t elements_to_append) override
        {
            size_t elements_appended = min(buffer_size_ - size_, elements_to_append);

            if (elements_appended == 0)
            {
                return 0; //  also skips memcpy with a null buffer (failed allocation), which is undefined even for 0 bytes
            }

            memcpy(buffer_ + size_, block_to_append, elements_appended * sizeof(T));

            size_ += elements_appended;

            return elements_appended;
        }

        void pop_back()
        {
            if (size_ > 0)
            {
                --size_;
            }
        }

    private:
        size_t buffer_size_;
        size_t size_;

        T buffer_[SIZE];
    };

    template <typename T>
    class heap_buffer : public buffer<T>
    {
    public:

        heap_buffer(pmr::memory_resource &resource, size_t size)
            : resource_(resource),
              buffer_size_(size),
              size_(0),
              buffer_(size <= (SIZE_MAX / sizeof(T)) ? static_cast<T *>(resource_.allocate(sizeof(T) * size, alignof(T))) : nullptr)
        {
            if (buffer_ == nullptr)
            {
                buffer_size_ = 0; //  behaves as an empty, full buffer: append() copies nothing

                if (size != 0)
                {
                    MINIMAL_STD_OUT_OF_MEMORY((size <= (SIZE_MAX / sizeof(T))) ? sizeof(T) * size : SIZE_MAX, alignof(T));
                }
            }
        }

        //  Moving transfers ownership of the block.  The source is left empty, and the
        //      destructor already skips a null buffer_, so the block is freed exactly once.

        heap_buffer(heap_buffer &&buffer_to_move) noexcept
            : resource_(buffer_to_move.resource_),
              buffer_size_(buffer_to_move.buffer_size_),
              size_(buffer_to_move.size_),
              buffer_(buffer_to_move.buffer_)
        {
            buffer_to_move.buffer_ = nullptr;
            buffer_to_move.buffer_size_ = 0;
            buffer_to_move.size_ = 0;
        }
   
        heap_buffer(const heap_buffer &) = delete;
        heap_buffer &operator=(const heap_buffer &) = delete;
        heap_buffer &operator=(heap_buffer &&) = delete;

        virtual ~heap_buffer()
        {
            if (buffer_ != nullptr)
            {
                resource_.deallocate(buffer_, sizeof(T) * buffer_size_, alignof(T));
                buffer_ = nullptr;
            }
        }

        size_t buffer_size() const override
        {
            return buffer_size_;
        }

        size_t size() const override
        {
            return size_;
        }

        size_t space_remaining() const override
        {
            return buffer_size_ - size_;
        }

        void clear() override
        {
            size_ = 0;
        }

        T *data() override
        {
            return buffer_;
        }

        const T *data() const override
        {
            return buffer_;
        }

        T &operator[](size_t index) override
        {
            return buffer_[index];
        }

        const T &operator[](size_t index) const override
        {
            return buffer_[index];
        }

        size_t append(T element_to_append) override
        {
            return append(&element_to_append, 1);
        }

        size_t append(const T *block_to_append, size_t elements_to_append) override
        {
            size_t elements_appended = min(buffer_size_ - size_, elements_to_append);

            if (elements_appended == 0)
            {
                return 0; //  also skips memcpy with a null buffer (failed allocation), which is undefined even for 0 bytes
            }

            memcpy(buffer_ + size_, block_to_append, elements_appended * sizeof(T));

            size_ += elements_appended;

            return elements_appended;
        }

        void pop_back()
        {
            if (size_ > 0)
            {
                --size_;
            }
        }

    private:
        pmr::memory_resource &resource_;
        size_t buffer_size_;
        size_t size_;

        T *buffer_;
    };
} // namespace minstd