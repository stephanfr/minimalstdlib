#pragma once

#include "minstdconfig.h"

// Use the project string.h so strlcpy/strnlen are available and avoid
// conflicting toolchain prototypes during aarch64 builds.
#include "string.h"

#include "algorithm"
#include "allocator"

namespace MINIMAL_STD_NAMESPACE
{
    template <typename T, size_t MAX_SIZE = DEFAULT_FIXED_STRING_MAX_SIZE>
    class basic_fixed_string;

    template <typename T, size_t MAX_SIZE = DEFAULT_DYNAMIC_STRING_MAX_SIZE>
    class basic_dynamic_string;

    template <typename T>
    class basic_string
    {
    public:
        static constexpr size_t npos = SIZE_MAX;

        typedef T ValueType;

        basic_string() = delete;
        basic_string(basic_string &&) = delete;

        basic_string &operator=(basic_string &&string_to_copy) = delete;

        ~basic_string() = default;

        basic_string &operator=(const T *value)
        {
            return assign_range(0, value, strnlen(value, max_size_));
        }

        basic_string &operator=(const basic_string &string_to_copy)
        {
            if (this == &string_to_copy)
            {
                return *this;
            }

            return assign_range(0, string_to_copy.buffer_, string_to_copy.length_);
        }

        template <size_t OTHER_MAX_SIZE>
        basic_string &operator=(const basic_fixed_string<T, OTHER_MAX_SIZE> &string_to_copy);

        template <size_t OTHER_MAX_SIZE>
        basic_string &operator=(const basic_dynamic_string<T, OTHER_MAX_SIZE> &string_to_copy);

        bool operator==(const basic_string<T> &value) const
        {
            return length_ != value.length_ ? false : (strncmp(buffer_, value.buffer_, length_) == 0);
        }

        bool operator==(const T *value) const
        {
            return (strnlen(value, buffer_size_) == length_) && (strncmp(buffer_, value, length_) == 0);
        }

        bool operator>(const basic_string<T> &value) const
        {
            return strncmp(buffer_, value.buffer_, minstd::max(length_, value.length_)) > 0;
        }

        bool operator>(const T *value) const
        {
            return strncmp(buffer_, value, minstd::max(length_, strnlen(value, buffer_size_))) > 0;
        }

        bool operator<(const basic_string<T> &value) const
        {
            return strncmp(buffer_, value.buffer_, minstd::max(length_, value.length_)) < 0;
        }

        bool operator<(const T *value) const
        {
            return strncmp(buffer_, value, minstd::max(length_, strnlen(value, buffer_size_))) < 0;
        }

        constexpr T &operator[](size_t pos)
        {
            if (pos >= length_)
            {
                //  A scratch character reset on every call: a stray write through it cannot leak into later reads.
                out_of_range_scratch_ = 0;
                return out_of_range_scratch_;
            }

            return buffer_[pos];
        }

        constexpr const T &operator[](size_t pos) const
        {
            if (pos >= length_)
            {
                return EMPTY_CHARACTER;
            }

            return buffer_[pos];
        }

        operator const T *() const
        {
            return buffer_;
        }

        constexpr void clear() noexcept
        {
            length_ = 0;
            buffer_[0] = 0;
        }

        const T *c_str() const
        {
            return buffer_;
        }

        const T *data() const
        {
            return buffer_;
        }

        //  The most characters the string can hold

        size_t max_size() const
        {
            return max_size_;
        }

        size_t size() const
        {
            return length_;
        }

        size_t length() const
        {
            return length_;
        }

        [[nodiscard]] constexpr bool empty() const noexcept
        {
            return length_ == 0;
        }

        basic_string<T> &operator+=(const T value)
        {
            push_back(value);

            return *this;
        }

        basic_string<T> &operator+=(const T *value)
        {
            return assign_range(length_, value, strnlen(value, max_size_));
        }

        //  Appends up to length characters of value, stopping at a terminator (value need not be terminated
        //      within length).
        basic_string<T> &append(const T *value, size_t length)
        {
            if (length == 0)
            {
                return *this;
            }

            return assign_range(length_, value, strnlen(value, length));
        }

        constexpr const T &back() const
        {
            if (length_ == 0)
            {
                return EMPTY_CHARACTER;
            }

            return buffer_[length_ - 1];
        }

        constexpr bool push_back(T character)
        {
            if (basic_string<T>::length_ >= basic_string<T>::max_size_)
            {
                return false;
            }

            if (character == 0x00)
            {
                return true;
            }

            grow_buffer(1);

            if (basic_string<T>::length_ >= chars_that_fit())
            {
                return false; //  the buffer could not grow
            }

            basic_string<T>::buffer_[basic_string<T>::length_++] = character;
            basic_string<T>::buffer_[basic_string<T>::length_] = 0;

            return true;
        }

        constexpr void pop_back()
        {
            if (length_ > 0)
            {
                buffer_[--length_] = 0;
            }
        }

        constexpr basic_string &erase(size_t index = 0, size_t count = npos)
        {
            if (index >= length_)
            {
                return *this;
            }

            if ((count > length_) || ((index + count) > length_))
            {
                buffer_[index] = 0;
                length_ = index;
            }
            else
            {
                for (size_t i = index; i + count < length_; i++)
                {
                    buffer_[i] = buffer_[i + count];
                }

                length_ -= count;
                buffer_[length_] = 0;
            }

            return *this;
        }

        constexpr size_t find_last_of(T ch, size_t pos = npos) const noexcept
        {
            if (length_ == 0)
            {
                return npos;
            }

            size_t search_start_index = ((pos == npos) || (pos >= length_)) ? (length_ - 1) : pos;

            while (true)
            {
                if (buffer_[search_start_index] == ch)
                {
                    return search_start_index;
                }

                if (search_start_index == 0)
                {
                    break;
                }

                search_start_index--;
            }

            return npos;
        }

        constexpr size_t find(const T *string_to_search_for, size_t pos = 0) const
        {
            if (pos > length_)
            {
                return npos;
            }

            if (string_to_search_for[0] == 0)
            {
                return pos;
            }

            char *location = strnstr(buffer_ + pos, string_to_search_for, length_ - pos);

            return location == NULL ? npos : static_cast<size_t>(location - buffer_);
        }

        constexpr size_t find(const T char_to_search_for, size_t pos = 0) const
        {
            for (size_t i = pos; i < length_; i++)
            {
                if (buffer_[i] == char_to_search_for)
                {
                    return i;
                }
            }

            return npos;
        }

        void substr(basic_string &substring, size_t pos = 0, size_t count = npos) const
        {
            const size_t start = minstd::min(pos, length_);
            const size_t chars_to_copy = minstd::min(minstd::min(count, length_ - start), substring.max_size_);

            //  The destination's old contents are replaced: grow for the copy alone, not on top of them.  The copy
            //      runs front to back, so a string can take a substring of itself.
            if (&substring != this)
            {
                substring.clear();
            }

            substring.grow_buffer(chars_to_copy);

            const size_t copy_limit = minstd::min(chars_to_copy, substring.chars_that_fit());

            for (size_t i = 0; i < copy_limit; i++)
            {
                substring.buffer_[i] = buffer_[start + i];
            }

            substring.buffer_[copy_limit] = 0;
            substring.length_ = copy_limit;
        }

    protected:
        T *buffer_;

        size_t buffer_size_;
        const size_t max_size_;

        size_t length_;

        const T EMPTY_CHARACTER = 0x00;
        T out_of_range_scratch_ = 0x00;

        explicit basic_string(T *buffer, size_t buffer_size, size_t max_size)
            : buffer_(buffer),
              buffer_size_(buffer_size),
              max_size_(max_size),
              length_(0)
        {
            buffer_[0] = 0;
        }

        explicit basic_string(T *buffer, size_t buffer_size, size_t max_size, const T *value)
            : buffer_(buffer),
              buffer_size_(buffer_size),
              max_size_(max_size)
        {
            length_ = copy_terminated(value, strnlen(value, max_size_));
        }

        //  Copies up to length characters, stopping at a terminator (value need not be terminated within length;
        //      npos means "up to the terminator").
        explicit constexpr basic_string(T *buffer, size_t buffer_size, size_t max_size, const T *value, size_t length)
            : buffer_(buffer),
              buffer_size_(buffer_size),
              max_size_(max_size)
        {
            length_ = copy_terminated(value, strnlen(value, minstd::min(length, max_size_)));
        }

        explicit basic_string(T *buffer, size_t buffer_size, size_t max_size, const basic_string &string_to_copy)
            : buffer_(buffer),
              buffer_size_(buffer_size),
              max_size_(max_size)
        {
            length_ = copy_terminated(string_to_copy.buffer_, string_to_copy.length_);
        }

        //  Constructors: copies count characters (clipped to the buffer) and terminates.  Returns the length.
        constexpr size_t copy_terminated(const T *value, size_t count)
        {
            const size_t to_copy = minstd::min(count, chars_that_fit());

            for (size_t i = 0; i < to_copy; ++i)
            {
                buffer_[i] = value[i];
            }

            buffer_[to_copy] = 0;

            return to_copy;
        }

        //  Replaces everything from offset (at most length_) with count characters of src, growing the buffer first
        //      and clipping to what fits.  src may point into this string's own buffer (s += s, s = s.c_str() + 1):
        //      growing can move the buffer, so such a source is re-based on the new buffer, and the copy is a
        //      memmove.  count must be computed before the call.
        basic_string &assign_range(size_t offset, const T *src, size_t count)
        {
            const uintptr_t old_buffer = reinterpret_cast<uintptr_t>(buffer_);
            const uintptr_t src_address = reinterpret_cast<uintptr_t>(src);
            const bool aliased = (src_address >= old_buffer) && (src_address < old_buffer + (buffer_size_ * sizeof(T)));
            const size_t src_offset = aliased ? static_cast<size_t>(src - buffer_) : 0;

            offset = minstd::min(offset, length_);

            if (offset + count > length_)
            {
                grow_buffer(offset + count - length_); //  keeps buffer_[0, length_]
            }

            if (aliased)
            {
                src = buffer_ + src_offset;
            }

            const size_t fit = chars_that_fit();

            offset = minstd::min(offset, fit);
            count = minstd::min(count, fit - offset);

            memmove(buffer_ + offset, src, count * sizeof(T));

            length_ = offset + count;
            buffer_[length_] = 0;

            return *this;
        }

        virtual void grow_buffer_for_string(const T *str) = 0;
        virtual void grow_buffer(size_t chars_needed) = 0;

        //  Characters the current buffer can hold, leaving room for the terminator.  Smaller than max_size_ when
        //      a dynamic string could not grow its buffer.
        constexpr size_t chars_that_fit() const
        {
            return minstd::min(max_size_, buffer_size_ - 1);
        }
    };

    using string = basic_string<char>;
}
