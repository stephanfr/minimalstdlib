#pragma once

#include "minstdconfig.h"

#include <stdint.h>
#include <string.h>

#include "algorithm"
#include "allocator"
#include "allocator_traits"
#include "basic_string"

namespace MINIMAL_STD_NAMESPACE
{
    template <typename T, size_t MAX_SIZE> //  Default value for MAX_SIZE is in the forward declaration at the top of the file
    class basic_dynamic_string : public basic_string<T>
    {
    public:
        static constexpr size_t npos = SIZE_MAX;

        using allocator_type = allocator<T>;
        using allocator_traits_type = minstd::allocator_traits<allocator_type>;

        explicit basic_dynamic_string(allocator_type &allocator)
            : basic_string<T>(allocate_buffer(allocator, minstd::min( DEFAULT_DYNAMIC_STRING_SIZE, MAX_SIZE + 1 )), minstd::min( DEFAULT_DYNAMIC_STRING_SIZE, MAX_SIZE + 1 ), MAX_SIZE),
              allocator_(allocator)
        {
        }

        explicit basic_dynamic_string(const T *value, allocator_type &allocator)
                        : basic_string<T>(allocate_buffer(allocator, compute_buffer_size(value)), compute_buffer_size(value), MAX_SIZE, value),
              allocator_(allocator)
        {
        }

        explicit basic_dynamic_string(const T *value, size_t length, allocator_type &allocator)
                        : basic_string<T>(allocate_buffer(allocator, compute_buffer_size(value, length)), compute_buffer_size(value, length), MAX_SIZE, value, length),
              allocator_(allocator)
        {
        }

        explicit basic_dynamic_string(const basic_string<T> &string_to_copy, allocator_type &allocator)
                        : basic_string<T>(allocate_buffer(allocator, compute_buffer_size(string_to_copy.length())), compute_buffer_size(string_to_copy.length()), MAX_SIZE, string_to_copy),
              allocator_(allocator)
        {
        }

        virtual ~basic_dynamic_string()
        {
            if (basic_string<T>::buffer_ != nullptr)
            {
                allocator_traits_type::deallocate(allocator_, basic_string<T>::buffer_, basic_string<T>::buffer_size_);
            }
        }

        //  Assignment goes through basic_string::assign_range(), which grows the buffer keeping its contents, so the
        //      source may be this string or point into it.

        basic_dynamic_string &operator=(const basic_dynamic_string &string_to_copy)
        {
            if (this != &string_to_copy)
            {
                basic_string<T>::assign_range(0, string_to_copy.data(), string_to_copy.length());
            }

            return *this;
        }

        basic_dynamic_string &operator=(const basic_string<T> &string_to_copy)
        {
            if (static_cast<const basic_string<T> *>(this) != &string_to_copy)
            {
                basic_string<T>::assign_range(0, string_to_copy.data(), string_to_copy.length());
            }

            return *this;
        }

        basic_dynamic_string &operator=(const T *string_to_copy)
        {
            basic_string<T>::assign_range(0, string_to_copy, strnlen(string_to_copy, basic_string<T>::max_size_));

            return *this;
        }

    private:
        allocator_type &allocator_;

        //  basic_string's constructor copies into the buffer before ours runs, so a constructor cannot recover
        //      from a failed allocation.
        static T *allocate_buffer(allocator_type &allocator, size_t size)
        {
            T *buffer = allocator_traits_type::allocate(allocator, size);

            if ((size != 0) && (buffer == nullptr))
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(T) * size, alignof(T), __builtin_trap());
            }

            return buffer;
        }

        static size_t compute_buffer_size( const char* value, size_t length = MAX_SIZE)
        {
            return compute_buffer_size(strnlen(value, length));
        }

        static size_t compute_buffer_size( size_t length)
        {
            return minstd::min( (size_t)((length + 1) * DYNAMIC_STRING_OVERALLOCATION_PERCENTAGE), MAX_SIZE + 1);
        }

        void grow_buffer_for_string(const T *str) override
        {
            grow_buffer(strnlen(str, basic_string<T>::max_size_));

        }

        void grow_buffer(size_t chars_needed) override
        {

            if (basic_string<T>::buffer_size_ >= basic_string<T>::max_size_ + 1)
            {
                return;
            }

            if (basic_string<T>::length_ + chars_needed + 1 > basic_string<T>::buffer_size_)
            {
                size_t new_buffer_size = minstd::min((size_t)((basic_string<T>::length_ + chars_needed + 1) * DYNAMIC_STRING_OVERALLOCATION_PERCENTAGE), basic_string<T>::max_size_ + 1 );

                T *new_buffer = allocator_traits_type::allocate(allocator_, new_buffer_size);

                if (new_buffer_size != 0 && new_buffer == nullptr)
                {
                    //  Keep the old buffer; callers write only what fits in buffer_size_.
                    MINIMAL_STD_OUT_OF_MEMORY(sizeof(T) * new_buffer_size, alignof(T), return);
                }

                strlcpy(new_buffer, basic_string<T>::buffer_, basic_string<T>::length_ + 1);

                allocator_traits_type::deallocate(allocator_, basic_string<T>::buffer_, basic_string<T>::buffer_size_);

                basic_string<T>::buffer_ = new_buffer;

                basic_string<T>::buffer_size_ = new_buffer_size;
            }
        }
    };

    template <typename T>
    template <size_t OTHER_MAX_SIZE>
    basic_string<T> &basic_string<T>::operator=(const basic_dynamic_string<T, OTHER_MAX_SIZE> &string_to_copy)
    {
        if (static_cast<const basic_string<T> *>(&string_to_copy) == this)
        {
            return *this;
        }

        return assign_range(0, string_to_copy.data(), string_to_copy.length());
    }

    //  Declare a dynamic string class with the char data type

    template <size_t MAX_SIZE = DEFAULT_DYNAMIC_STRING_MAX_SIZE>
    using dynamic_string = basic_dynamic_string<char, MAX_SIZE>;
}
