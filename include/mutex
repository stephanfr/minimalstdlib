    //
    //  Lock tags - as std::defer_lock, std::try_to_lock and std::adopt_lock
    //

    struct defer_lock_t
    {
        explicit defer_lock_t() = default;
    };

    struct try_to_lock_t
    {
        explicit try_to_lock_t() = default;
    };

    struct adopt_lock_t
    {
        explicit adopt_lock_t() = default;
    };

    inline constexpr defer_lock_t defer_lock{};
    inline constexpr try_to_lock_t try_to_lock{};
    inline constexpr adopt_lock_t adopt_lock{};

    //
    //  spin_mutex - the std::mutex interface (lock, try_lock, unlock), but waiters spin.
    //      This mutex is not suitable for long-term blocking or use in interrupt handlers.
    //

    class spin_mutex
    {
    public:
        constexpr spin_mutex() noexcept = default;
        ~spin_mutex() = default;

        spin_mutex(const spin_mutex &) = delete;
        spin_mutex &operator=(const spin_mutex &) = delete;

        void lock() noexcept
        {
            size_t retries = 0;

            while (locked_.exchange(true, memory_order_acquire))
            {
                while (locked_.load(memory_order_relaxed))
                {
                    platform::back_off(retries);
                }
            }
        }

        bool try_lock() noexcept
        {
            return !locked_.load(memory_order_relaxed) && !locked_.exchange(true, memory_order_acquire);
        }

        void unlock() noexcept
        {
            locked_.store(false, memory_order_release);
        }

    private:
        atomic<bool> locked_{false};
    };

    //
    //  recursive_spin_mutex - the std::recursive_mutex interface.  The library knows nothing of
    //      threads or tasks, so OwnerPolicy records the owner.
    //

    template <typename OwnerPolicy>
    class recursive_spin_mutex
    {
    public:
        constexpr recursive_spin_mutex() noexcept = default;
        ~recursive_spin_mutex() = default;

        recursive_spin_mutex(const recursive_spin_mutex &) = delete;
        recursive_spin_mutex &operator=(const recursive_spin_mutex &) = delete;

        void lock() noexcept
        {
            const uintptr_t caller = OwnerPolicy::current_owner();

            MINIMAL_STD_ASSERT(caller != NO_OWNER);

            if (owner_.load(memory_order_relaxed) == caller)
            {
                depth_++;
                return;
            }

            mutex_.lock();

            owner_.store(caller, memory_order_relaxed);
            depth_ = 1;
        }

        bool try_lock() noexcept
        {
            const uintptr_t caller = OwnerPolicy::current_owner();

            MINIMAL_STD_ASSERT(caller != NO_OWNER);

            if (owner_.load(memory_order_relaxed) == caller)
            {
                depth_++;
                return true;
            }

            if (!mutex_.try_lock())
            {
                return false;
            }

            owner_.store(caller, memory_order_relaxed);
            depth_ = 1;

            return true;
        }

        void unlock() noexcept
        {
            if (owner_.load(memory_order_relaxed) != OwnerPolicy::current_owner())
            {
                contract_violation("recursive_spin_mutex unlocked by a caller that does not hold it", __FILE__, __LINE__);
                return;
            }

            if (--depth_ == 0)
            {
                owner_.store(NO_OWNER, memory_order_relaxed);
                mutex_.unlock();
            }
        }

    private:
        //  Owner ids are compared against this, so it must be a value no owner can have.  0 is a natural id
        //      (core 0 when the owner is the CPU id), so it cannot be the sentinel.
        static constexpr uintptr_t NO_OWNER = ~static_cast<uintptr_t>(0);

        spin_mutex mutex_;
        atomic<uintptr_t> owner_{NO_OWNER};
        uint32_t depth_ = 0;
    };

    //
    //  lock_guard - as std::lock_guard
    //

    template <typename Mutex>
    class lock_guard
    {
    public:
        using mutex_type = Mutex;

        explicit lock_guard(mutex_type &mutex)
            : mutex_(mutex)
        {
            mutex_.lock();
        }

        lock_guard(mutex_type &mutex, adopt_lock_t) noexcept
            : mutex_(mutex)
        {
        }

        ~lock_guard()
        {
            mutex_.unlock();
        }

        lock_guard(const lock_guard &) = delete;
        lock_guard &operator=(const lock_guard &) = delete;

    private:
        mutex_type &mutex_;
    };

    //
    //  unique_lock - as std::unique_lock.
    //

    template <typename Mutex>
    class unique_lock
    {
    public:
        using mutex_type = Mutex;

        unique_lock() noexcept = default;

        explicit unique_lock(mutex_type &mutex)
            : mutex_(&mutex)
        {
            mutex_->lock();
            owns_ = true;
        }

        unique_lock(mutex_type &mutex, defer_lock_t) noexcept
            : mutex_(&mutex)
        {
        }

        unique_lock(mutex_type &mutex, try_to_lock_t)
            : mutex_(&mutex),
              owns_(mutex.try_lock())
        {
        }

        unique_lock(mutex_type &mutex, adopt_lock_t) noexcept
            : mutex_(&mutex),
              owns_(true)
        {
        }

        ~unique_lock()
        {
            if (owns_)
            {
                mutex_->unlock();
            }
        }

        unique_lock(const unique_lock &) = delete;
        unique_lock &operator=(const unique_lock &) = delete;

        unique_lock(unique_lock &&other) noexcept
            : mutex_(other.mutex_),
              owns_(other.owns_)
        {
            other.mutex_ = nullptr;
            other.owns_ = false;
        }

        unique_lock &operator=(unique_lock &&other) noexcept
        {
            if (this != &other)
            {
                if (owns_)
                {
                    mutex_->unlock();
                }

                mutex_ = other.mutex_;
                owns_ = other.owns_;

                other.mutex_ = nullptr;
                other.owns_ = false;
            }

            return *this;
        }

        void lock()
        {
            if ((mutex_ == nullptr) || owns_)
            {
                contract_violation("unique_lock::lock with no mutex, or already owning it", __FILE__, __LINE__);
                return;
            }

            mutex_->lock();
            owns_ = true;
        }

        bool try_lock()
        {
            if ((mutex_ == nullptr) || owns_)
            {
                contract_violation("unique_lock::try_lock with no mutex, or already owning it", __FILE__, __LINE__);
                return false;
            }

            owns_ = mutex_->try_lock();

            return owns_;
        }

        void unlock()
        {
            if (!owns_)
            {
                contract_violation("unique_lock::unlock while not owning the mutex", __FILE__, __LINE__);
                return;
            }

            mutex_->unlock();
            owns_ = false;
        }

        void swap(unique_lock &other) noexcept
        {
            mutex_type *mutex = mutex_;
            bool owns = owns_;

            mutex_ = other.mutex_;
            owns_ = other.owns_;

            other.mutex_ = mutex;
            other.owns_ = owns;
        }

        mutex_type *release() noexcept
        {
            mutex_type *mutex = mutex_;

            mutex_ = nullptr;
            owns_ = false;

            return mutex;
        }

        bool owns_lock() const noexcept
        {
            return owns_;
        }

        explicit operator bool() const noexcept
        {
            return owns_;
        }

        mutex_type *mutex() const noexcept
        {
            return mutex_;
        }

    private:
        mutex_type *mutex_ = nullptr;
        bool owns_ = false;
    };
} // namespace MINIMAL_STD_NAMESPACE