    //  Packs a position together with an epoch/generation counter into one
    //  atomic word.  Only used by the multi-consumer dequeue path: a plain
    //  atomic<size_t> position reset to 0 on every segment reopen exposes a
    //  genuine ABA hazard -- a consumer thread's stale CAS attempt from a
    //  previous "life" of a segment could otherwise spuriously match a new
    //  life's counter.  Tagging the position with a counter that increments
    //  on every reopen makes a stale attempt from an earlier life impossible
    //  to alias against the current one.
    struct tagged_position
    {
        using storage_type = uint64_t;

        static constexpr int EPOCH_BITS = 16;
        static constexpr storage_type POS_MASK = (storage_type{1} << (64 - EPOCH_BITS)) - 1;

        static constexpr storage_type pack(size_t pos, uint16_t epoch)
        {
            return (static_cast<storage_type>(epoch) << (64 - EPOCH_BITS)) | (static_cast<storage_type>(pos) & POS_MASK);
        }

        static constexpr size_t unpack_pos(storage_type value)
        {
            return static_cast<size_t>(value & POS_MASK);
        }

        static constexpr uint16_t unpack_epoch(storage_type value)
        {
            return static_cast<uint16_t>(value >> (64 - EPOCH_BITS));
        }
    };

    //  Packs a position together with the CURRENT LIFE's capacity into one
    //  atomic word, for the enqueue side (both consumer modes -- this is not
    //  a multi-consumer-only concern).  A plain ascending fetch_add
    //  compared, after the fact, against a separately-read capacity_ field
    //  is not safe: a producer that gets an overflowing (invalid) claim and
    //  is then descheduled before checking it can wake up after the segment
    //  has since drained and regrown to a larger capacity, and have that
    //  later, larger capacity make its stale claim look valid.  Since
    //  capacity only ever grows, this is not a rare corner case -- it is the
    //  expected outcome whenever a producer is delayed across a regrow.
    //  Packing the claiming life's own capacity into the same atomic word
    //  the position comes from makes the bound check self-contained: the
    //  capacity a producer checks its claim against is always the exact one
    //  in effect at the moment of its own fetch_add, never a later one.
    //  (An earlier attempt to fix this by counting DOWN from capacity
    //  instead -- so overflow was detectable from the return value alone,
    //  with no capacity read at all -- turned out to invert claim order to
    //  a top-down suffix, which breaks the low-to-high contiguous-prefix
    //  claim order the sequential dequeue side depends on: whenever
    //  production stops before a segment is fully claimed, which is the
    //  common case at shutdown, the consumer would permanently stall on
    //  low, never-claimed slots while already-published high slots sit
    //  unreachable behind them. This scheme keeps ascending claim order
    //  intact and fixes only the staleness of the bound check itself.)
    struct tagged_enqueue_state
    {
        using storage_type = uint64_t;

        //  Split evenly at 32/32. Capacity needs real headroom -- under
        //  sustained, saturated throughput (producer and consumer both
        //  continuously busy, never idling) a segment genuinely fills and
        //  triggers a real regrow every single life, with no natural lull
        //  to let growth taper off, so capacity climbs for as long as that
        //  throughput continues; 24 bits (16.7M) was observed to be crossed
        //  within a single benchmark run. Position needs real headroom too:
        //  nothing blocks other producer threads from continuing to
        //  fetch_add against an already-exhausted counter for the entire
        //  duration of the regrow's allocate+construct loop (whose own cost
        //  scales with the new capacity), so a narrow position budget is
        //  its own overflow-into-capacity-bits hazard at large capacities.
        //  32 bits each gives ~4.29 billion headroom on both sides --
        //  already a physically implausible capacity (would require
        //  terabytes of backing memory) or claim-pileup count.
        static constexpr int CAPACITY_BITS = 32;
        static constexpr storage_type POS_MASK = (storage_type{1} << (64 - CAPACITY_BITS)) - 1;

        static constexpr storage_type pack(size_t capacity, size_t pos)
        {
            return (static_cast<storage_type>(capacity) << (64 - CAPACITY_BITS)) | (static_cast<storage_type>(pos) & POS_MASK);
        }

        static constexpr size_t unpack_capacity(storage_type value)
        {
            return static_cast<size_t>(value >> (64 - CAPACITY_BITS));
        }

        static constexpr size_t unpack_pos(storage_type value)
        {
            return static_cast<size_t>(value & POS_MASK);
        }
    };

    //  Multi-producer lock-free queue, growable via SegmentCount ring-buffer
    //  segments arranged in a fixed cycle, with a compile-time choice of
    //  single- or multi-consumer operation.
    //
    //  A segment is only ever resized once fully drained, so growth never
    //  copies live data -- it just reallocates empty memory to a larger
    //  capacity (growth_numerator_/growth_denominator_ x the next segment's
    //  current capacity in ring order, ~1.25x by default) and brings it
    //  back into rotation.
    //
    //  idle_rotation_interval (constructor parameter, 0/default disables
    //  this) opportunistically closes a segment's life early -- before it
    //  organically fills -- if it is running under 50% loaded once that
    //  many pops have occurred, so it can reopen SMALLER instead of only
    //  ever being eligible to shrink after being completely refilled to a
    //  possibly burst-inflated capacity again first (which, once a burst
    //  subsides, may never happen). See maybe_shrink_active_segment().
    //
    //  SegmentCount (default 2) controls how many segments are kept in
    //  rotation simultaneously.  Raising it gives push_back() more
    //  pre-allocated headroom to absorb a producer burst before ever
    //  returning false, WITHOUT introducing any new coordination between
    //  producer threads: every segment in the ring is always already
    //  allocated ahead of need (via the same drain-then-regrow mechanism as
    //  the 2-segment case), so walking to the next one during a burst is
    //  only ever a pointer follow, never an on-demand allocation racing
    //  multiple producers to decide who performs it. Raising SegmentCount
    //  only raises the threshold before the ring is genuinely exhausted --
    //  it cannot eliminate that possibility for a long enough sustained
    //  burst, so push_back() can still return false and callers must still
    //  handle that (the same way any bounded queue's caller must).
    //
    //  MultiConsumer == false: pop_front()/empty() are consumer-thread-only
    //  and use no atomics beyond a per-slot published-flag check -- this is
    //  the entire reason to pick this mode: zero contention on the pop side.
    //  MultiConsumer == true: pop_front()/empty() may be called from any
    //  number of consumer threads concurrently, at the cost of a CAS-claimed,
    //  epoch-tagged position per segment.
    //
    //  Ordering: two pushes from the same producer thread that land in the
    //  same segment are observed by consumers in that order.  There is no
    //  ordering guarantee across different producer threads, nor across a
    //  segment boundary -- a push into a newly-active segment can be
    //  observed before an earlier push still queued behind a slower
    //  publisher in another segment.  This relaxation is required: always
    //  draining one segment to its declared capacity before ever considering
    //  the rest of the ring would permanently strand published items
    //  whenever production stops before a segment's capacity happens to be
    //  exactly exhausted.
    template <typename T, bool MultiConsumer = false, size_t SegmentCount = 2>
    class mp_mc_sc_growable_ring_queue
    {
        static_assert(SegmentCount >= 2, "mp_mc_sc_growable_ring_queue requires at least 2 segments");

    public:
        using value_type = T;

        struct slot_type
        {
            atomic<bool> ready_;
            alignas(T) unsigned char storage_[sizeof(T)];

            slot_type()
                : ready_(false)
            {
            }

            T *element_ptr()
            {
                return reinterpret_cast<T *>(storage_);
            }
        };

        using allocator_type = allocator<slot_type>;
        using allocator_traits_type = minstd::allocator_traits<allocator_type>;

    private:
        //  Multi-consumer only: a segment's buffer is never freed directly --
        //  it is wrapped in a retired_descriptor and reclaimed through a
        //  hazard_pointer_domain, so retire_and_grow() can safely hand an old
        //  buffer off for deletion while another consumer thread might still
        //  be mid-read from it (the peek-before-claim hazard that a bare
        //  claim-order/completion-count scheme cannot close). A single
        //  consumer never faces that hazard -- there is no second thread that
        //  could be behind it -- so the single-consumer path keeps its plain
        //  buffer_/capacity_ fields and never touches any of this.
        struct retired_descriptor;

        using domain_type = lockfree::hazard_pointer_domain<retired_descriptor, 64, 64, 8>;

        struct retired_descriptor : lockfree::hazardous_resource<retired_descriptor, domain_type>
        {
            slot_type *buffer_;

            //  original_capacity_ is the PHYSICAL size this buffer was
            //  allocated at -- immutable for the descriptor's whole life,
            //  exactly like buffer_/allocator_, and used wherever the real
            //  allocation size matters (destructor cleanup, deallocate()'s
            //  size argument, array-indexing safety).
            //
            //  capacity_ is the CURRENT, effective size for THIS life --
            //  starts equal to original_capacity_, but can be reduced
            //  exactly once, opportunistically, by maybe_shrink_active_segment()
            //  if this segment is running well under capacity (see there).
            //  It is atomic (unlike buffer_/original_capacity_/allocator_,
            //  which truly never change) because, under MultiConsumer, any
            //  consumer thread's periodic check may reduce it while other
            //  consumer threads concurrently read it via their own hazard
            //  guard. That's safe: the per-slot ready_ flag remains the sole
            //  authority on whether a slot was ever published, so a reader
            //  observing a stale (not-yet-reduced) snapshot of capacity_
            //  only affects a fast-path bound check, never memory safety --
            //  the physical buffer never shrinks mid-life, only the
            //  "how much of it counts for this life" value does.
            size_t original_capacity_;
            atomic<size_t> capacity_;
            allocator_type *allocator_;

            retired_descriptor(domain_type &domain, slot_type *buffer, size_t capacity, allocator_type *allocator)
                : lockfree::hazardous_resource<retired_descriptor, domain_type>(domain),
                  buffer_(buffer),
                  original_capacity_(capacity),
                  capacity_(capacity),
                  allocator_(allocator)
            {
            }

            //  A retired_descriptor is destroyed either when the domain
            //  reclaims it (growth-cycle retirement -- every slot is
            //  guaranteed fully drained by then) or directly by the queue's
            //  own destructor for whichever descriptor is still current at
            //  shutdown (production may have stopped mid-fill, leaving a
            //  non-contiguous claimed/unclaimed mix) -- so this must check
            //  ready_ per slot rather than assume every slot holds a live T.
            //  Iterates original_capacity_ (the physical allocation), not
            //  capacity_ (which may have been opportunistically reduced
            //  below the physical size) -- every physically-constructed
            //  slot_type wrapper must be destroyed, and deallocate() must
            //  be called with the size it was originally allocated at.
            ~retired_descriptor()
            {
                for (size_t i = 0; i < original_capacity_; ++i)
                {
                    if (buffer_[i].ready_.load(memory_order_acquire))
                    {
                        buffer_[i].element_ptr()->~T();
                    }

                    allocator_traits_type::destroy(*allocator_, &buffer_[i]);
                }

                allocator_traits_type::deallocate(*allocator_, buffer_, original_capacity_);
            }
        };

        struct no_domain
        {
        };

    public:
        //  idle_rotation_interval: every that many successful pop_front()
        //  calls (globally across the whole queue, counted via a single
        //  fetch_add so exactly one caller ever crosses a given multiple),
        //  opportunistically check whether the currently-active segment is
        //  running under 50% loaded, and if so, close its current life
        //  early so it can reopen smaller once it finishes draining --
        //  see maybe_shrink_active_segment(). 0 (the default) disables
        //  this entirely: capacity then only ever grows, exactly as
        //  before. This exists so a queue that grew during a burst can
        //  give some of that memory back afterward, without requiring the
        //  segment to be completely refilled to its (now inflated)
        //  capacity again first -- which, after a burst subsides, may
        //  never happen.
        explicit mp_mc_sc_growable_ring_queue(allocator_type &allocator,
                                               size_t initial_capacity,
                                               size_t growth_numerator = 5,
                                               size_t growth_denominator = 4,
                                               size_t idle_rotation_interval = 0)
            : allocator_(allocator),
              growth_numerator_(growth_numerator),
              growth_denominator_(growth_denominator),
              idle_rotation_interval_(idle_rotation_interval)
        {
            for (size_t i = 0; i < SegmentCount; ++i)
            {
                open_segment(segments_[i], initial_capacity);
            }

            for (size_t i = 0; i < SegmentCount; ++i)
            {
                segments_[i].next_ = &segments_[(i + 1) % SegmentCount];
            }

            producer_target_.store(&segments_[0], memory_order_relaxed);
            store_consumer_target(&segments_[0]);
        }

        mp_mc_sc_growable_ring_queue(const mp_mc_sc_growable_ring_queue &) = delete;
        mp_mc_sc_growable_ring_queue(mp_mc_sc_growable_ring_queue &&) = delete;
        mp_mc_sc_growable_ring_queue &operator=(const mp_mc_sc_growable_ring_queue &) = delete;
        mp_mc_sc_growable_ring_queue &operator=(mp_mc_sc_growable_ring_queue &&) = delete;

        //  Precondition: no producer threads are concurrently pushing during
        //  destruction (same convention as spsc_queue).
        ~mp_mc_sc_growable_ring_queue()
        {
            for (size_t i = 0; i < SegmentCount; ++i)
            {
                destroy_segment(segments_[i]);
            }
        }

        //  May be called from any number of producer threads concurrently,
        //  regardless of MultiConsumer.  Returns false only when every
        //  segment in the ring is currently full.
        template <class... Args>
        bool push_back(Args &&...args)
        {
            segment *target = producer_target_.load(memory_order_relaxed);

            for (size_t attempt = 0; attempt < SegmentCount; ++attempt)
            {
                //  Safe to forward on every attempt even though args may be
                //  needed again below: try_claim_and_publish only ever
                //  touches args if the claim succeeds (in which case we
                //  return immediately and never need them again); a failed
                //  claim returns before constructing anything.
                if (try_claim_and_publish(*target, minstd::forward<Args>(args)...))
                {
                    return true;
                }

                if (attempt + 1 < SegmentCount)
                {
                    target = target->next_;

                    //  No CAS needed: next_ is a fixed, pre-existing ring
                    //  member, not something producers race to create --
                    //  redundant stores of the same value from multiple
                    //  producers are race-free.  Storing between every
                    //  attempt (not just the last) lets the next push_back
                    //  call resume from wherever this one left off, instead
                    //  of re-trying segments already known to be exhausted.
                    producer_target_.store(target, memory_order_relaxed);
                }
            }

            return false;
        }

        //  If MultiConsumer == false: must only be called from a single
        //  thread. If MultiConsumer == true: may be called from any number
        //  of consumer threads concurrently.  Returning false does not
        //  always mean the queue is empty -- it can also mean a producer is
        //  transiently mid-push.  Callers must retry.
        bool pop_front(T &front)
        {
            segment *candidate = load_consumer_target();

            //  Multi-consumer only: ONE hazard guard for the whole call,
            //  re-targeted (protect()) per segment attempt, instead of a
            //  full acquire/release cycle inside every try_pop_from -- on
            //  an empty-looking queue that halves (or better, for larger
            //  SegmentCount) the guard traffic per call.  protect()
            //  performs the targeted-reclaim re-check when it retargets
            //  away from a pointer, so reclamation stays as prompt as with
            //  per-attempt guards.  Default-constructed (invalid, unused)
            //  in single-consumer mode.
            [[maybe_unused]] typename domain_type::hazard_guard guard;

            if constexpr (MultiConsumer)
            {
                guard = domain_.acquire_guard();
            }

            for (size_t attempt = 0; attempt < SegmentCount; ++attempt)
            {
                if (try_pop_from(*candidate, front, guard))
                {
                    store_consumer_target(candidate);

                    //  idle_rotation_interval_ == 0 (the default) disables
                    //  this entirely -- capacity then only ever grows,
                    //  exactly as before this feature existed. Otherwise,
                    //  every idle_rotation_interval_-th successful pop
                    //  (globally, across the whole queue) opportunistically
                    //  checks whether the active segment could be shrunk.
                    //  The fetch_add (multi-consumer) or plain increment
                    //  (single-consumer) returns a unique value per call, so
                    //  exactly one caller ever observes a given exact
                    //  multiple -- no extra coordination needed for that.
                    if (idle_rotation_interval_ != 0)
                    {
                        size_t count;

                        if constexpr (MultiConsumer)
                        {
                            count = pop_count_.fetch_add(1, memory_order_relaxed) + 1;
                        }
                        else
                        {
                            count = ++pop_count_;
                        }

                        if (count % idle_rotation_interval_ == 0)
                        {
                            maybe_shrink_active_segment();
                        }
                    }

                    return true;
                }

                candidate = candidate->next_;
            }

            return false;
        }

        //  Consumer-thread-only (even under MultiConsumer -- a best-effort
        //  hint, not a linearizable query): false is authoritative, true
        //  only means "nothing available right now."
        bool empty() const
        {
            for (size_t i = 0; i < SegmentCount; ++i)
            {
                if (has_ready(segments_[i]))
                {
                    return false;
                }
            }

            return true;
        }

        //  Consumer-thread-only diagnostic: sum of every segment's current
        //  declared capacity.  Lets callers confirm growth actually happened.
        size_t capacity_estimate() const
        {
            size_t total = 0;

            if constexpr (MultiConsumer)
            {
                typename domain_type::hazard_guard guard = domain_.acquire_guard();

                for (size_t i = 0; i < SegmentCount; ++i)
                {
                    retired_descriptor *d = guard.protect(segments_[i].current_);
                    total += d->capacity_.load(memory_order_acquire);
                }
            }
            else
            {
                for (size_t i = 0; i < SegmentCount; ++i)
                {
                    total += segments_[i].capacity_;
                }
            }

            return total;
        }

    private:
        //  Padding audit finding: an unpadded segment (all fields below,
        //  declared as plain consecutive members with no isolation) fit in
        //  EXACTLY one 64-byte cache line on every configuration measured
        //  (single- and multi-consumer, confirmed via sizeof deltas across
        //  SegmentCount). That meant enqueue_pos_ (written by every
        //  producer on every push_back) and dequeue_state_ (written by the
        //  consumer side on every pop_front) were guaranteed to share one
        //  line -- real false sharing that hits the primary
        //  1-producer/1-consumer case just as hard as any multi-producer
        //  burst, since it bounces the same line between the two cores on
        //  every single operation in either direction.
        //
        //  The fields are split by ACCESS pattern, not by which role "owns"
        //  them, into three cache lines:
        //
        //  1. read-mostly (next_/buffer_/original_capacity_/capacity_/
        //     current_): read by producers on EVERY push (buffer_ or
        //     current_) and by consumers on every pop, but written only at
        //     segment open/regrow -- so the line sits in Shared state on
        //     every core and nobody invalidates anyone. Grouping these with
        //     either hot counter instead would put a field producers must
        //     read every push on a line consumers dirty every pop (or vice
        //     versa), reintroducing a miss per operation -- exactly the
        //     mistake the first-generation split made by parking buffer_/
        //     current_ next to dequeue_state_.
        //
        //  2. producer-hot (enqueue_pos_): the only field producers write
        //     on the fast path, alone on its line.
        //
        //  3. consumer-hot (dequeue_state_, retire_claimed_): written by
        //     the consumer side on every pop (dequeue_state_) or at life
        //     boundaries (retire_claimed_), alone on their line.
        static constexpr size_t CACHE_LINE_SIZE = 64;

        struct segment
        {
            //  --- Cache line 1: read-mostly, written only at open/regrow ---

            //  Fixed ring member -- always the next segment in a
            //  SegmentCount-length cycle (never reallocated, never
            //  repointed after construction).  Named next_ rather than
            //  other_/sibling_ because with SegmentCount > 2 it is one of
            //  several ring neighbors, not a single dedicated partner; for
            //  the SegmentCount == 2 default it is exactly the old sibling_
            //  (a 2-cycle: A -> B -> A).
            alignas(CACHE_LINE_SIZE) segment *next_ = nullptr;

            //  Single-consumer only: authoritative, plain fields -- no
            //  indirection, no atomics beyond enqueue_pos_ below, since only
            //  one thread ever touches this segment's buffer.  Left at their
            //  initial values (harmless, a few bytes) and never touched when
            //  MultiConsumer is true.
            //
            //  original_capacity_ is the PHYSICAL size this buffer was
            //  allocated at this life (used for destructor cleanup and
            //  deallocate()'s size argument); capacity_ is the CURRENT,
            //  effective size for this life, which maybe_shrink_active_segment()
            //  may reduce below original_capacity_ exactly once per life.
            //  Both remain plain, non-atomic fields here: the sole consumer
            //  thread is the only one that ever reads or writes either, in
            //  single-consumer mode, including when performing that shrink
            //  (see maybe_shrink_active_segment()) -- no new synchronization
            //  is needed on this path.
            size_t original_capacity_ = 0;
            size_t capacity_ = 0;
            slot_type *buffer_ = nullptr;

            //  Multi-consumer only: the sole authority for this segment's
            //  buffer/capacity, reached exclusively through a hazard guard.
            //  A retired_descriptor's buffer_/capacity_ are immutable for
            //  its entire life -- retire_and_grow_multi() never mutates an
            //  existing descriptor, only swaps in a brand-new one -- so once
            //  a thread has safely obtained the current descriptor pointer,
            //  dereferencing it is safe for as long as that thread holds it.
            //  Left null (harmless) and never touched when MultiConsumer is
            //  false.
            atomic<retired_descriptor *> current_{nullptr};

            //  --- Cache line 2: producer-hot ---

            //  Packs the claiming life's capacity together with the
            //  ascending position counter -- see tagged_enqueue_state above.
            //  Applies uniformly regardless of MultiConsumer: the staleness
            //  hazard this closes is not specific to multi-consumer mode.
            //  The single hottest producer-side field in the structure --
            //  isolated on its own line so no consumer-side write ever
            //  invalidates it, and vice versa.
            alignas(CACHE_LINE_SIZE) atomic<tagged_enqueue_state::storage_type> enqueue_pos_{0};

            //  --- Cache line 3: consumer-hot ---

            //  Dequeue-position representation is conditional on
            //  MultiConsumer: plain size_t (single-consumer, no atomics at
            //  all) vs. an epoch-tagged atomic<uint64_t> (multi-consumer,
            //  CAS-claimed -- see tagged_position above for why the epoch
            //  tag is required).
            alignas(CACHE_LINE_SIZE) conditional_t<MultiConsumer, atomic<tagged_position::storage_type>, size_t> dequeue_state_{};

            //  Multi-consumer only: arbitrates who actually calls
            //  retire_and_grow_multi() for a given life. Normally that's
            //  uniquely the one consumer thread whose CAS completes the
            //  last position (see try_pop_from's "no straggler left"
            //  note). But maybe_shrink_active_segment() can close a life
            //  early at a point the consumer side has *already* fully
            //  drained -- in that case no future pop would ever re-check
            //  completion, so the shrink-check must trigger it instead;
            //  since a normal completion and a shrink-triggered one could
            //  race on the SAME life if a normal consumer's own capacity_
            //  read straddles the shrink's update, exactly one of them must
            //  win this CAS. Reset to false every time a life opens.
            //  Unused (harmless) when MultiConsumer is false, since the
            //  single-consumer path handles the same "already caught up"
            //  case directly, with no concurrent caller to arbitrate
            //  against.
            atomic<bool> retire_claimed_{false};
        };

        //  Layout guards: catch any future field reordering/addition that
        //  would silently reintroduce the false sharing this padding was
        //  added to eliminate.
        static_assert(offsetof(segment, next_) == 0,
                      "read-mostly group must start the struct");
        static_assert(offsetof(segment, enqueue_pos_) == CACHE_LINE_SIZE,
                      "enqueue_pos_ must start its own cache line, isolated from the read-mostly group");
        static_assert(offsetof(segment, dequeue_state_) == 2 * CACHE_LINE_SIZE,
                      "dequeue_state_ must start its own cache line, isolated from enqueue_pos_");

        using consumer_target_type = conditional_t<MultiConsumer, atomic<segment *>, segment *>;

        void open_segment(segment &seg, size_t capacity)
        {
            slot_type *buffer = allocator_traits_type::allocate(allocator_, capacity);

            if (buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * capacity, alignof(slot_type));
                capacity = 0;
            }

            for (size_t i = 0; i < capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &buffer[i]);
            }

            seg.enqueue_pos_.store(tagged_enqueue_state::pack(capacity, 0), memory_order_relaxed);

            if constexpr (MultiConsumer)
            {
                seg.current_.store(new retired_descriptor(domain_, buffer, capacity, &allocator_), memory_order_relaxed);
                seg.retire_claimed_.store(false, memory_order_relaxed);
                seg.dequeue_state_.store(tagged_position::pack(0, 0), memory_order_relaxed);
            }
            else
            {
                seg.buffer_ = buffer;
                seg.original_capacity_ = capacity;
                seg.capacity_ = capacity;
                seg.dequeue_state_ = 0;
            }
        }

        void destroy_segment(segment &seg)
        {
            if constexpr (MultiConsumer)
            {
                //  No concurrent activity during destruction (same
                //  precondition as spsc_queue): safe to delete the current
                //  descriptor directly rather than going through retire().
                delete seg.current_.load(memory_order_relaxed);
            }
            else
            {
                //  Iterates original_capacity_ (the physical allocation),
                //  not capacity_ (which may have been opportunistically
                //  reduced below the physical size) -- see the comment on
                //  segment::original_capacity_.
                for (size_t i = 0; i < seg.original_capacity_; ++i)
                {
                    //  Only slots a producer actually published still hold a
                    //  live T (production may have stopped mid-fill, leaving
                    //  a non-contiguous mix of claimed and never-claimed
                    //  slots) -- skip past unclaimed slots, never stop
                    //  early.
                    if (seg.buffer_[i].ready_.load(memory_order_acquire))
                    {
                        seg.buffer_[i].element_ptr()->~T();
                    }

                    allocator_traits_type::destroy(allocator_, &seg.buffer_[i]);
                }

                allocator_traits_type::deallocate(allocator_, seg.buffer_, seg.original_capacity_);
            }
        }

        template <class... Args>
        bool try_claim_and_publish(segment &seg, Args &&...args)
        {
            //  fetch_add still hands out an ascending, contiguous-from-zero
            //  position within the current life (unchanged claim order --
            //  the sequential dequeue side depends on it), but the capacity
            //  to validate that position against comes from the SAME atomic
            //  word, frozen at the exact instant of this producer's own
            //  fetch_add (see tagged_enqueue_state above).  That makes the
            //  bound check self-contained: it can never observe a LATER
            //  life's (larger) capacity, however long this producer is
            //  delayed before checking it, closing a real hazard where a
            //  producer with an overflowing claim could otherwise wake after
            //  the segment regrew and have the new, larger capacity make its
            //  stale claim look valid -- corrupting a slot two lives now
            //  race over (single-consumer) or dereferencing an
            //  already-freed descriptor (multi-consumer).  A valid claim (idx
            //  < capacity_at_claim) needs no such protection: it is, by
            //  construction, guaranteed to be within [0, capacity) for
            //  whichever life is current at the moment of the fetch_add, and
            //  that life cannot retire until this exact claim publishes (see
            //  try_pop_from's "no straggler left" note) -- so reading the
            //  buffer afterward, however delayed, is safe without any
            //  further check.
            tagged_enqueue_state::storage_type before = seg.enqueue_pos_.fetch_add(1, memory_order_acquire);
            size_t capacity_at_claim = tagged_enqueue_state::unpack_capacity(before);
            size_t idx = tagged_enqueue_state::unpack_pos(before);

            if (idx >= capacity_at_claim)
            {
                return false;
            }

            if constexpr (MultiConsumer)
            {
                retired_descriptor *desc = seg.current_.load(memory_order_acquire);

                allocator_traits_type::construct(allocator_, desc->buffer_[idx].element_ptr(), minstd::forward<Args>(args)...);
                desc->buffer_[idx].ready_.store(true, memory_order_release);
            }
            else
            {
                allocator_traits_type::construct(allocator_, seg.buffer_[idx].element_ptr(), minstd::forward<Args>(args)...);
                seg.buffer_[idx].ready_.store(true, memory_order_release);
            }

            return true;
        }

        //  guard: caller-owned (see pop_front), valid whenever
        //  MultiConsumer is true; completely ignored in single-consumer
        //  mode.
        bool try_pop_from(segment &seg, T &front, [[maybe_unused]] typename domain_type::hazard_guard &guard)
        {
            if constexpr (MultiConsumer)
            {
                //  Protects the descriptor -- and therefore the buffer it
                //  points to -- for the entire duration of this call: peek,
                //  CAS, read, and destroy all happen while the caller's
                //  hazard slot protects `desc`, which is exactly the gap
                //  (peek-before-claim) that a bare claim-order/completion-
                //  count scheme could not close. The caller's eventual
                //  guard release (or retarget to another segment's
                //  descriptor) is the event that may trigger this
                //  descriptor's actual reclaim, if this call happened to be
                //  the one that retired it.
                retired_descriptor *desc = guard.protect(seg.current_);

                tagged_position::storage_type state = seg.dequeue_state_.load(memory_order_acquire);

                while (true)
                {
                    size_t pos = tagged_position::unpack_pos(state);

                    if (pos >= desc->capacity_.load(memory_order_acquire))
                    {
                        return false;
                    }

                    slot_type &s = desc->buffer_[pos];

                    if (!s.ready_.load(memory_order_acquire))
                    {
                        return false;
                    }

                    tagged_position::storage_type next_state = tagged_position::pack(pos + 1, tagged_position::unpack_epoch(state));

                    if (seg.dequeue_state_.compare_exchange_strong(state, next_state, memory_order_acq_rel, memory_order_acquire))
                    {
                        front = minstd::move(*s.element_ptr());
                        allocator_traits_type::destroy(allocator_, s.element_ptr());
                        s.ready_.store(false, memory_order_relaxed);

                        //  Claim order is safe to trigger on directly here:
                        //  the CAS above only ever advances dequeue_state_ by
                        //  exactly one position at a time, and only past a
                        //  position whose ready_ flag was just observed
                        //  true -- so by the time this position reaches
                        //  capacity_, every earlier position in this life has
                        //  already been claimed AND completed, in order,
                        //  which in turn required every one of their
                        //  producers to have already finished publishing.
                        //  There is no straggler left to protect against;
                        //  the hazard guard above exists to protect THIS
                        //  thread's own read, not to stagger the trigger.
                        //  Fresh (acquire) read: capacity_ may have been
                        //  opportunistically reduced by
                        //  maybe_shrink_active_segment() since this call
                        //  started, and that reduced value is exactly what
                        //  this life's completion should be measured
                        //  against.
                        size_t effective_capacity = desc->capacity_.load(memory_order_acquire);

                        if (pos + 1 == effective_capacity)
                        {
                            //  Arbitrate against maybe_shrink_active_segment(),
                            //  which can also detect this same completion
                            //  (if this life was capped and already fully
                            //  drained by the time the cap applied) -- see
                            //  segment::retire_claimed_.
                            bool expected = false;

                            if (seg.retire_claimed_.compare_exchange_strong(expected, true, memory_order_acq_rel, memory_order_relaxed))
                            {
                                retire_and_grow_multi(seg, desc, effective_capacity);
                            }
                        }

                        return true;
                    }

                    //  CAS failed: `state` was refreshed to the actual
                    //  current packed value; loop and recheck.
                }
            }
            else
            {
                if (seg.dequeue_state_ >= seg.capacity_)
                {
                    return false;
                }

                slot_type &s = seg.buffer_[seg.dequeue_state_];

                if (!s.ready_.load(memory_order_acquire))
                {
                    return false;
                }

                front = minstd::move(*s.element_ptr());
                allocator_traits_type::destroy(allocator_, s.element_ptr());
                s.ready_.store(false, memory_order_relaxed);
                ++seg.dequeue_state_;

                if (seg.dequeue_state_ == seg.capacity_)
                {
                    retire_and_grow(seg);
                }

                return true;
            }
        }

        bool has_ready(const segment &seg) const
        {
            if constexpr (MultiConsumer)
            {
                typename domain_type::hazard_guard guard = domain_.acquire_guard();
                retired_descriptor *desc = guard.protect(seg.current_);
                size_t pos = tagged_position::unpack_pos(seg.dequeue_state_.load(memory_order_acquire));

                if (pos >= desc->capacity_.load(memory_order_acquire))
                {
                    return false;
                }

                return desc->buffer_[pos].ready_.load(memory_order_acquire);
            }
            else
            {
                size_t pos = seg.dequeue_state_;

                if (pos >= seg.capacity_)
                {
                    return false;
                }

                return seg.buffer_[pos].ready_.load(memory_order_acquire);
            }
        }

        segment *load_consumer_target() const
        {
            if constexpr (MultiConsumer)
            {
                return consumer_target_.load(memory_order_relaxed);
            }
            else
            {
                return consumer_target_;
            }
        }

        void store_consumer_target(segment *s)
        {
            if constexpr (MultiConsumer)
            {
                consumer_target_.store(s, memory_order_relaxed);
            }
            else
            {
                consumer_target_ = s;
            }
        }

        size_t compute_new_capacity(size_t reference_capacity) const
        {
            size_t grown = (reference_capacity * growth_numerator_ + growth_denominator_ - 1) / growth_denominator_;
            return grown > reference_capacity ? grown : reference_capacity + 1;
        }

        //  Inverse of compute_new_capacity, applied to a segment's OWN
        //  just-closed size (not a sibling reference) when a life was
        //  closed early by maybe_shrink_active_segment() rather than
        //  filling organically. Shrinks gradually (by the same ratio
        //  growth uses, in reverse) so repeated idle cycles settle toward
        //  a smaller size rather than jumping to an arbitrary reference;
        //  floored at 1 to avoid a degenerate zero-capacity segment.
        size_t compute_shrunk_capacity(size_t current) const
        {
            size_t shrunk = (current * growth_denominator_) / growth_numerator_;
            return shrunk > 0 ? shrunk : 1;
        }

        //  Single-consumer only: only ever called once a segment is proven
        //  fully drained, by the sole consumer thread, so there is exactly
        //  one caller and no concurrent reader/writer of buffer_/capacity_
        //  to protect against.
        void retire_and_grow(segment &seg)
        {
            //  Was this life's capacity_ opportunistically reduced below
            //  its original_capacity_ (see maybe_shrink_active_segment)? If
            //  so, this is not an organic full-drain -- demand fell off
            //  before this life ever filled -- so the next life should
            //  shrink, not grow, relative to its OWN just-closed size. An
            //  organic full-drain (capacity_ == original_capacity_) grows
            //  as always, relative to the NEXT segment in the ring.
            bool was_capped = seg.capacity_ < seg.original_capacity_;

            //  For SegmentCount == 2 the "next segment" reference is the
            //  same single sibling as before; for SegmentCount > 2 it is
            //  simply a fixed, consistent reference point. Growth is
            //  monotonic and every segment eventually reopens based on
            //  whatever its neighbor grew to, so all ring members converge
            //  to within one growth factor of each other over enough
            //  cycles.
            size_t new_capacity = was_capped
                                      ? compute_shrunk_capacity(seg.capacity_)
                                      : compute_new_capacity(seg.next_->capacity_);

            //  Allocate the new buffer before freeing the old one, so an
            //  allocator failure degrades to "recycle at the old physical
            //  capacity" instead of leaving the segment without a buffer.
            slot_type *new_buffer = allocator_traits_type::allocate(allocator_, new_capacity);
            size_t effective_capacity = new_capacity;

            //  Destroys/deallocates using original_capacity_ (the physical
            //  allocation), not capacity_ (which may be smaller if this
            //  life was capped) -- see the comment on segment::original_capacity_.
            for (size_t i = 0; i < seg.original_capacity_; ++i)
            {
                allocator_traits_type::destroy(allocator_, &seg.buffer_[i]);
            }

            if (new_buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * new_capacity, alignof(slot_type));
                new_buffer = seg.buffer_;
                effective_capacity = seg.original_capacity_;
            }
            else
            {
                allocator_traits_type::deallocate(allocator_, seg.buffer_, seg.original_capacity_);
            }

            for (size_t i = 0; i < effective_capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &new_buffer[i]);
            }

            seg.buffer_ = new_buffer;
            seg.original_capacity_ = effective_capacity;
            seg.capacity_ = effective_capacity;

            //  Reopen gates: plain buffer_/capacity_ writes above MUST
            //  precede this release-store, since the sole consumer thread's
            //  own next dequeue_state_ read is a plain (non-atomic) read
            //  that simply follows program order, and the producer side's
            //  fetch_add on enqueue_pos_ (acquire) must observe it.
            seg.dequeue_state_ = 0;
            seg.enqueue_pos_.store(tagged_enqueue_state::pack(effective_capacity, 0), memory_order_release);
        }

        //  Multi-consumer only: called once `desc` (the descriptor this
        //  thread just finished reading the last position of) is proven
        //  fully drained, at effective_capacity (the life's capacity_ at
        //  the moment of that completion -- see try_pop_from's fresh read).
        //  Never mutates `desc`'s buffer_/original_capacity_/allocator_ --
        //  only ever swaps in a brand-new descriptor and hands `desc` off
        //  to the domain via retire() -- since other consumer threads may
        //  still be mid-call with a hazard guard protecting `desc`, reading
        //  its fields (see try_pop_from's "no straggler left" note: those
        //  reads are always stale-but-safe, never a live race, precisely
        //  because buffer_/original_capacity_/allocator_ never change after
        //  construction; capacity_ is the sole exception, see its comment).
        void retire_and_grow_multi(segment &seg, retired_descriptor *desc, size_t effective_capacity_at_close)
        {
            //  Was this life's capacity_ opportunistically reduced below
            //  its original_capacity_ (see maybe_shrink_active_segment)? If
            //  so, this is not an organic full-drain, so the next life
            //  should shrink relative to its own just-closed size rather
            //  than grow relative to the sibling -- see retire_and_grow's
            //  identical reasoning.
            bool was_capped = effective_capacity_at_close < desc->original_capacity_;

            size_t new_capacity;

            if (was_capped)
            {
                new_capacity = compute_shrunk_capacity(effective_capacity_at_close);
            }
            else
            {
                //  Grows relative to the NEXT segment in the ring -- see
                //  retire_and_grow's comment above; the reasoning is
                //  identical.
                typename domain_type::hazard_guard sibling_guard = domain_.acquire_guard();
                retired_descriptor *sibling_desc = sibling_guard.protect(seg.next_->current_);
                new_capacity = compute_new_capacity(sibling_desc->capacity_.load(memory_order_acquire));
            }

            slot_type *new_buffer = allocator_traits_type::allocate(allocator_, new_capacity);

            if (new_buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * new_capacity, alignof(slot_type));

                //  Recycle at the old (full physical) capacity: reopen the
                //  SAME descriptor for another life rather than allocating
                //  a new one. `desc`'s buffer_/original_capacity_/allocator_
                //  are left completely untouched, so any thread still
                //  holding a hazard-protected reference to it (see the note
                //  above) remains safe regardless of this reopen; capacity_
                //  is reset back to the full original_capacity_ since
                //  there's no reason to keep a shrunk logical size when
                //  recycling the same (already fully-sized) physical buffer.
                desc->capacity_.store(desc->original_capacity_, memory_order_relaxed);
                seg.retire_claimed_.store(false, memory_order_relaxed);
                uint16_t next_epoch = static_cast<uint16_t>(tagged_position::unpack_epoch(seg.dequeue_state_.load(memory_order_relaxed)) + 1);
                seg.dequeue_state_.store(tagged_position::pack(0, next_epoch), memory_order_release);
                seg.enqueue_pos_.store(tagged_enqueue_state::pack(desc->original_capacity_, 0), memory_order_release);
                return;
            }

            for (size_t i = 0; i < new_capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &new_buffer[i]);
            }

            retired_descriptor *new_desc = new retired_descriptor(domain_, new_buffer, new_capacity, &allocator_);

            //  Reopen gates: the descriptor swap MUST precede these
            //  release-stores, since producers/other consumers gate on
            //  enqueue_pos_/dequeue_state_ (acquire) before trusting
            //  seg.current_ to already reflect this new life.
            seg.current_.store(new_desc, memory_order_release);
            seg.retire_claimed_.store(false, memory_order_relaxed);

            uint16_t next_epoch = static_cast<uint16_t>(tagged_position::unpack_epoch(seg.dequeue_state_.load(memory_order_relaxed)) + 1);
            seg.dequeue_state_.store(tagged_position::pack(0, next_epoch), memory_order_release);
            seg.enqueue_pos_.store(tagged_enqueue_state::pack(new_capacity, 0), memory_order_release);

            //  Hand the old descriptor off for hazard-protected deferred
            //  deletion -- safe to reclaim immediately once no consumer
            //  thread (including this one, whose own guard still protects
            //  it until try_pop_from returns) still holds a hazard pointer
            //  to it.
            desc->retire();
        }

        //  Opportunistically closes the currently-active segment's life
        //  early if it is running well under capacity, so it can reopen
        //  smaller once it finishes draining, instead of only ever being
        //  eligible to shrink after being completely refilled to its
        //  (possibly burst-inflated) declared capacity again first -- which,
        //  once a burst subsides, may never happen. Called from pop_front()
        //  every idle_rotation_interval_ successful pops (0 disables this
        //  entirely). A single opportunistic CAS attempt, not a retry loop:
        //  if it fails (some producer claimed another slot in the
        //  meantime), this check is simply skipped for now -- there will be
        //  another chance at the next interval.
        void maybe_shrink_active_segment()
        {
            segment *target = producer_target_.load(memory_order_relaxed);

            tagged_enqueue_state::storage_type state = target->enqueue_pos_.load(memory_order_acquire);
            size_t capacity_at_check = tagged_enqueue_state::unpack_capacity(state);
            size_t position_at_check = tagged_enqueue_state::unpack_pos(state);

            //  Skip: nothing claimed yet (capping to zero would be
            //  degenerate), already overflowing (this life is already
            //  organically complete or completing), or already at/above the
            //  50% load threshold.
            if (position_at_check == 0 || position_at_check >= capacity_at_check || position_at_check * 2 >= capacity_at_check)
            {
                return;
            }

            tagged_enqueue_state::storage_type capped_state = tagged_enqueue_state::pack(position_at_check, position_at_check);

            if (!target->enqueue_pos_.compare_exchange_strong(state, capped_state, memory_order_acq_rel, memory_order_relaxed))
            {
                return;
            }

            if constexpr (MultiConsumer)
            {
                typename domain_type::hazard_guard guard = domain_.acquire_guard();
                retired_descriptor *desc = guard.protect(target->current_);
                desc->capacity_.store(position_at_check, memory_order_release);

                //  The segment may already be fully drained relative to
                //  this new, smaller capacity (consumers already consumed
                //  everything published so far) -- if so, no FUTURE pop
                //  would ever re-check completion (try_pop_from's own
                //  bound check would reject any further attempt before
                //  ever reaching its completion check), so this call must
                //  recognize completion itself. retire_claimed_ ensures
                //  exactly one of (a normal consumer's own completion
                //  check) or (this one) ever actually triggers the regrow.
                size_t dequeue_pos_after = tagged_position::unpack_pos(target->dequeue_state_.load(memory_order_acquire));

                if (dequeue_pos_after >= position_at_check)
                {
                    bool expected = false;

                    if (target->retire_claimed_.compare_exchange_strong(expected, true, memory_order_acq_rel, memory_order_relaxed))
                    {
                        retire_and_grow_multi(*target, desc, position_at_check);
                    }
                }
            }
            else
            {
                target->capacity_ = position_at_check;

                //  Single-consumer only: this thread IS the sole consumer,
                //  so there is no concurrent completion path to arbitrate
                //  against -- if the segment is already caught up relative
                //  to the new capacity, triggering the regrow directly here
                //  is the only place it will ever be recognized.
                if (target->dequeue_state_ >= position_at_check)
                {
                    retire_and_grow(*target);
                }
            }
        }

        //  allocator_ (a stored reference) is read by BOTH producers and
        //  consumers on every construct/destroy, and the growth/interval
        //  fields are read at life boundaries -- all read-only after
        //  construction, so this first line stays in Shared state
        //  everywhere. pop_count_ deliberately does NOT live here: it is
        //  written by the consumer side on every pop when idle rotation is
        //  enabled, which would invalidate this line under every reader --
        //  it lives with the other consumer-written fields below instead.
        allocator_type &allocator_;
        size_t growth_numerator_;
        size_t growth_denominator_;
        size_t idle_rotation_interval_;
        segment segments_[SegmentCount];

        //  Same false-sharing concern as within segment above: producer_target_
        //  is read on every push_back and written on every segment-switch,
        //  while consumer_target_ is written on every successful pop_front --
        //  declared back-to-back with no isolation, they would otherwise be
        //  virtually guaranteed to share a line. domain_ is consumer/retire-
        //  path-only (its hazard guard is acquired on every MultiConsumer
        //  pop_front call), so it belongs on the consumer side of the split,
        //  not isolated further from consumer_target_ -- as does pop_count_
        //  (see the allocator_ comment above).
        alignas(CACHE_LINE_SIZE) atomic<segment *> producer_target_;

        alignas(CACHE_LINE_SIZE) consumer_target_type consumer_target_;
        conditional_t<MultiConsumer, atomic<size_t>, size_t> pop_count_{0};
        mutable conditional_t<MultiConsumer, domain_type, no_domain> domain_;
    };
}
