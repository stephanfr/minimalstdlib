    //  Packs a position together with an epoch/generation counter into one
    //  atomic word.  Only used by the multi-consumer dequeue path: a plain
    //  atomic<size_t> position reset to 0 on every segment reopen exposes a
    //  genuine ABA hazard -- a consumer thread's stale CAS attempt from a
    //  previous "life" of a segment could otherwise spuriously match a new
    //  life's counter.  Tagging the position with a counter that increments
    //  on every reopen makes a stale attempt from an earlier life impossible
    //  to alias against the current one.
    struct tagged_position
    {
        using storage_type = uint64_t;

        static constexpr int EPOCH_BITS = 16;
        static constexpr storage_type POS_MASK = (storage_type{1} << (64 - EPOCH_BITS)) - 1;

        static constexpr storage_type pack(size_t pos, uint16_t epoch)
        {
            return (static_cast<storage_type>(epoch) << (64 - EPOCH_BITS)) | (static_cast<storage_type>(pos) & POS_MASK);
        }

        static constexpr size_t unpack_pos(storage_type value)
        {
            return static_cast<size_t>(value & POS_MASK);
        }

        static constexpr uint16_t unpack_epoch(storage_type value)
        {
            return static_cast<uint16_t>(value >> (64 - EPOCH_BITS));
        }
    };

    //  Multi-producer lock-free queue, growable via two alternating
    //  ring-buffer segments, with a compile-time choice of single- or
    //  multi-consumer operation.
    //
    //  A segment is only ever resized once fully drained, so growth never
    //  copies live data -- it just reallocates empty memory to a larger
    //  capacity (growth_numerator_/growth_denominator_ x the sibling
    //  segment's current capacity, ~1.25x by default) and brings it back
    //  into rotation.
    //
    //  MultiConsumer == false: pop_front()/empty() are consumer-thread-only
    //  and use no atomics beyond a per-slot published-flag check -- this is
    //  the entire reason to pick this mode: zero contention on the pop side.
    //  MultiConsumer == true: pop_front()/empty() may be called from any
    //  number of consumer threads concurrently, at the cost of a CAS-claimed,
    //  epoch-tagged position per segment.
    //
    //  Ordering: two pushes from the same producer thread that land in the
    //  same segment are observed by consumers in that order.  There is no
    //  ordering guarantee across different producer threads, nor across a
    //  segment boundary -- a push into a newly-active segment can be
    //  observed before an earlier push still queued behind a slower
    //  publisher in the other segment.  This relaxation is required: always
    //  draining one segment to its declared capacity before ever considering
    //  the other would permanently strand published items whenever
    //  production stops before a segment's capacity happens to be exactly
    //  exhausted.
    template <typename T, bool MultiConsumer = false>
    class mp_mc_sc_growable_ring_queue
    {
    public:
        using value_type = T;

        struct slot_type
        {
            atomic<bool> ready_;
            alignas(T) unsigned char storage_[sizeof(T)];

            slot_type()
                : ready_(false)
            {
            }

            T *element_ptr()
            {
                return reinterpret_cast<T *>(storage_);
            }
        };

        using allocator_type = allocator<slot_type>;
        using allocator_traits_type = minstd::allocator_traits<allocator_type>;

    private:
        //  Multi-consumer only: a segment's buffer is never freed directly --
        //  it is wrapped in a retired_descriptor and reclaimed through a
        //  hazard_pointer_domain, so retire_and_grow() can safely hand an old
        //  buffer off for deletion while another consumer thread might still
        //  be mid-read from it (the peek-before-claim hazard that a bare
        //  claim-order/completion-count scheme cannot close). A single
        //  consumer never faces that hazard -- there is no second thread that
        //  could be behind it -- so the single-consumer path keeps its plain
        //  buffer_/capacity_ fields and never touches any of this.
        struct retired_descriptor;

        using domain_type = lockfree::hazard_pointer_domain<retired_descriptor, 64, 64, 8>;

        struct retired_descriptor : lockfree::hazardous_resource<retired_descriptor, domain_type>
        {
            slot_type *buffer_;
            size_t capacity_;
            allocator_type *allocator_;

            retired_descriptor(domain_type &domain, slot_type *buffer, size_t capacity, allocator_type *allocator)
                : lockfree::hazardous_resource<retired_descriptor, domain_type>(domain),
                  buffer_(buffer),
                  capacity_(capacity),
                  allocator_(allocator)
            {
            }

            //  A retired_descriptor is destroyed either when the domain
            //  reclaims it (growth-cycle retirement -- every slot is
            //  guaranteed fully drained by then) or directly by the queue's
            //  own destructor for whichever descriptor is still current at
            //  shutdown (production may have stopped mid-fill, leaving a
            //  non-contiguous claimed/unclaimed mix) -- so this must check
            //  ready_ per slot rather than assume every slot holds a live T.
            ~retired_descriptor()
            {
                for (size_t i = 0; i < capacity_; ++i)
                {
                    if (buffer_[i].ready_.load(memory_order_acquire))
                    {
                        buffer_[i].element_ptr()->~T();
                    }

                    allocator_traits_type::destroy(*allocator_, &buffer_[i]);
                }

                allocator_traits_type::deallocate(*allocator_, buffer_, capacity_);
            }
        };

        struct no_domain
        {
        };

    public:
        explicit mp_mc_sc_growable_ring_queue(allocator_type &allocator,
                                               size_t initial_capacity,
                                               size_t growth_numerator = 5,
                                               size_t growth_denominator = 4)
            : allocator_(allocator),
              growth_numerator_(growth_numerator),
              growth_denominator_(growth_denominator)
        {
            open_segment(segments_[0], initial_capacity);
            open_segment(segments_[1], initial_capacity);

            segments_[0].other_ = &segments_[1];
            segments_[1].other_ = &segments_[0];

            producer_target_.store(&segments_[0], memory_order_relaxed);
            store_consumer_target(&segments_[0]);
        }

        mp_mc_sc_growable_ring_queue(const mp_mc_sc_growable_ring_queue &) = delete;
        mp_mc_sc_growable_ring_queue(mp_mc_sc_growable_ring_queue &&) = delete;
        mp_mc_sc_growable_ring_queue &operator=(const mp_mc_sc_growable_ring_queue &) = delete;
        mp_mc_sc_growable_ring_queue &operator=(mp_mc_sc_growable_ring_queue &&) = delete;

        //  Precondition: no producer threads are concurrently pushing during
        //  destruction (same convention as spsc_queue).
        ~mp_mc_sc_growable_ring_queue()
        {
            destroy_segment(segments_[0]);
            destroy_segment(segments_[1]);
        }

        //  May be called from any number of producer threads concurrently,
        //  regardless of MultiConsumer.  Returns false only when both
        //  segments are currently full.
        template <class... Args>
        bool push_back(Args &&...args)
        {
            segment *target = producer_target_.load(memory_order_relaxed);

            //  Safe to forward on this attempt even though args may be
            //  needed again below: try_claim_and_publish only ever touches
            //  args if the claim succeeds (in which case we return
            //  immediately and never need them again); a failed claim
            //  returns before constructing anything.
            if (try_claim_and_publish(*target, minstd::forward<Args>(args)...))
            {
                return true;
            }

            segment *fallback = target->other_;

            //  No CAS needed: fallback is a fixed, pre-existing sibling, not
            //  something producers race to create -- redundant stores of the
            //  same value from multiple producers are race-free.
            producer_target_.store(fallback, memory_order_relaxed);

            return try_claim_and_publish(*fallback, minstd::forward<Args>(args)...);
        }

        //  If MultiConsumer == false: must only be called from a single
        //  thread. If MultiConsumer == true: may be called from any number
        //  of consumer threads concurrently.  Returning false does not
        //  always mean the queue is empty -- it can also mean a producer is
        //  transiently mid-push.  Callers must retry.
        bool pop_front(T &front)
        {
            segment *preferred = load_consumer_target();

            if (try_pop_from(*preferred, front))
            {
                return true;
            }

            segment *fallback = preferred->other_;

            if (try_pop_from(*fallback, front))
            {
                store_consumer_target(fallback);
                return true;
            }

            return false;
        }

        //  Consumer-thread-only (even under MultiConsumer -- a best-effort
        //  hint, not a linearizable query): false is authoritative, true
        //  only means "nothing available right now."
        bool empty() const
        {
            return !has_ready(segments_[0]) && !has_ready(segments_[1]);
        }

        //  Consumer-thread-only diagnostic: sum of both segments' current
        //  declared capacity.  Lets callers confirm growth actually happened.
        size_t capacity_estimate() const
        {
            if constexpr (MultiConsumer)
            {
                typename domain_type::hazard_guard g0 = domain_.acquire_guard();
                retired_descriptor *d0 = g0.protect(segments_[0].current_);
                typename domain_type::hazard_guard g1 = domain_.acquire_guard();
                retired_descriptor *d1 = g1.protect(segments_[1].current_);

                return d0->capacity_ + d1->capacity_;
            }
            else
            {
                return segments_[0].capacity_ + segments_[1].capacity_;
            }
        }

    private:
        struct segment
        {
            segment *other_ = nullptr;
            atomic<size_t> enqueue_pos_{0};

            //  Dequeue-position representation is conditional on
            //  MultiConsumer: plain size_t (single-consumer, no atomics at
            //  all) vs. an epoch-tagged atomic<uint64_t> (multi-consumer,
            //  CAS-claimed -- see tagged_position above for why the epoch
            //  tag is required).
            conditional_t<MultiConsumer, atomic<tagged_position::storage_type>, size_t> dequeue_state_{};

            //  Single-consumer only: authoritative, plain fields -- no
            //  indirection, no atomics beyond enqueue_pos_ above, since only
            //  one thread ever touches this segment's buffer.  Left at their
            //  initial values (harmless, a few bytes) and never touched when
            //  MultiConsumer is true.
            size_t capacity_ = 0;
            slot_type *buffer_ = nullptr;

            //  Multi-consumer only: the sole authority for this segment's
            //  buffer/capacity, reached exclusively through a hazard guard.
            //  A retired_descriptor's buffer_/capacity_ are immutable for
            //  its entire life -- retire_and_grow_multi() never mutates an
            //  existing descriptor, only swaps in a brand-new one -- so once
            //  a thread has safely obtained the current descriptor pointer,
            //  dereferencing it is safe for as long as that thread holds it.
            //  Left null (harmless) and never touched when MultiConsumer is
            //  false.
            atomic<retired_descriptor *> current_{nullptr};
        };

        using consumer_target_type = conditional_t<MultiConsumer, atomic<segment *>, segment *>;

        void open_segment(segment &seg, size_t capacity)
        {
            slot_type *buffer = allocator_traits_type::allocate(allocator_, capacity);

            if (buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * capacity, alignof(slot_type));
                capacity = 0;
            }

            for (size_t i = 0; i < capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &buffer[i]);
            }

            seg.enqueue_pos_.store(0, memory_order_relaxed);

            if constexpr (MultiConsumer)
            {
                seg.current_.store(new retired_descriptor(domain_, buffer, capacity, &allocator_), memory_order_relaxed);
                seg.dequeue_state_.store(tagged_position::pack(0, 0), memory_order_relaxed);
            }
            else
            {
                seg.buffer_ = buffer;
                seg.capacity_ = capacity;
                seg.dequeue_state_ = 0;
            }
        }

        void destroy_segment(segment &seg)
        {
            if constexpr (MultiConsumer)
            {
                //  No concurrent activity during destruction (same
                //  precondition as spsc_queue): safe to delete the current
                //  descriptor directly rather than going through retire().
                delete seg.current_.load(memory_order_relaxed);
            }
            else
            {
                for (size_t i = 0; i < seg.capacity_; ++i)
                {
                    //  Only slots a producer actually published still hold a
                    //  live T (production may have stopped mid-fill, leaving
                    //  a non-contiguous mix of claimed and never-claimed
                    //  slots) -- skip past unclaimed slots, never stop
                    //  early.
                    if (seg.buffer_[i].ready_.load(memory_order_acquire))
                    {
                        seg.buffer_[i].element_ptr()->~T();
                    }

                    allocator_traits_type::destroy(allocator_, &seg.buffer_[i]);
                }

                allocator_traits_type::deallocate(allocator_, seg.buffer_, seg.capacity_);
            }
        }

        template <class... Args>
        bool try_claim_and_publish(segment &seg, Args &&...args)
        {
            //  NOT a CAS loop: fetch_add is sufficient because enqueue_pos_
            //  is never reused in place within a life -- no wraparound to
            //  arbitrate, and fetch_add has no ABA exposure since it never
            //  compares against a remembered value.  acquire: must observe
            //  the reopen-gate release-store below if this claim belongs to
            //  a freshly-recycled life, so the bound check against capacity
            //  (and the buffer itself) is guaranteed up to date.
            size_t idx = seg.enqueue_pos_.fetch_add(1, memory_order_acquire);

            if constexpr (MultiConsumer)
            {
                //  No hazard guard needed here: retire_and_grow_multi() for
                //  THIS life cannot run until every valid claim in
                //  [0, capacity) -- including whichever one this fetch_add
                //  just returned, if it is valid -- has been both published
                //  and consumed (dequeue only ever advances one position at
                //  a time, and only past a position whose ready_ flag it has
                //  already observed true). So the descriptor this load
                //  returns is guaranteed to still be the current, live one
                //  for the entire remainder of this call.
                retired_descriptor *desc = seg.current_.load(memory_order_acquire);

                if (idx >= desc->capacity_)
                {
                    return false;
                }

                allocator_traits_type::construct(allocator_, desc->buffer_[idx].element_ptr(), minstd::forward<Args>(args)...);
                desc->buffer_[idx].ready_.store(true, memory_order_release);
            }
            else
            {
                if (idx >= seg.capacity_)
                {
                    return false;
                }

                allocator_traits_type::construct(allocator_, seg.buffer_[idx].element_ptr(), minstd::forward<Args>(args)...);
                seg.buffer_[idx].ready_.store(true, memory_order_release);
            }

            return true;
        }

        bool try_pop_from(segment &seg, T &front)
        {
            if constexpr (MultiConsumer)
            {
                //  Guards the descriptor -- and therefore the buffer it
                //  points to -- for the entire duration of this call: peek,
                //  CAS, read, and destroy all happen while this thread's
                //  hazard slot protects `desc`, which is exactly the gap
                //  (peek-before-claim) that a bare claim-order/completion-
                //  count scheme could not close. Releasing the guard on
                //  return (its destructor) is itself the event that may
                //  trigger this descriptor's actual reclaim, if this call
                //  happened to be the one that retired it.
                typename domain_type::hazard_guard guard = domain_.acquire_guard();
                retired_descriptor *desc = guard.protect(seg.current_);

                tagged_position::storage_type state = seg.dequeue_state_.load(memory_order_acquire);

                while (true)
                {
                    size_t pos = tagged_position::unpack_pos(state);

                    if (pos >= desc->capacity_)
                    {
                        return false;
                    }

                    slot_type &s = desc->buffer_[pos];

                    if (!s.ready_.load(memory_order_acquire))
                    {
                        return false;
                    }

                    tagged_position::storage_type next_state = tagged_position::pack(pos + 1, tagged_position::unpack_epoch(state));

                    if (seg.dequeue_state_.compare_exchange_strong(state, next_state, memory_order_acq_rel, memory_order_acquire))
                    {
                        front = minstd::move(*s.element_ptr());
                        allocator_traits_type::destroy(allocator_, s.element_ptr());
                        s.ready_.store(false, memory_order_relaxed);

                        //  Claim order is safe to trigger on directly here:
                        //  the CAS above only ever advances dequeue_state_ by
                        //  exactly one position at a time, and only past a
                        //  position whose ready_ flag was just observed
                        //  true -- so by the time this position reaches
                        //  capacity_, every earlier position in this life has
                        //  already been claimed AND completed, in order,
                        //  which in turn required every one of their
                        //  producers to have already finished publishing.
                        //  There is no straggler left to protect against;
                        //  the hazard guard above exists to protect THIS
                        //  thread's own read, not to stagger the trigger.
                        if (pos + 1 == desc->capacity_)
                        {
                            retire_and_grow_multi(seg, desc);
                        }

                        return true;
                    }

                    //  CAS failed: `state` was refreshed to the actual
                    //  current packed value; loop and recheck.
                }
            }
            else
            {
                if (seg.dequeue_state_ >= seg.capacity_)
                {
                    return false;
                }

                slot_type &s = seg.buffer_[seg.dequeue_state_];

                if (!s.ready_.load(memory_order_acquire))
                {
                    return false;
                }

                front = minstd::move(*s.element_ptr());
                allocator_traits_type::destroy(allocator_, s.element_ptr());
                s.ready_.store(false, memory_order_relaxed);
                ++seg.dequeue_state_;

                if (seg.dequeue_state_ == seg.capacity_)
                {
                    retire_and_grow(seg);
                }

                return true;
            }
        }

        bool has_ready(const segment &seg) const
        {
            if constexpr (MultiConsumer)
            {
                typename domain_type::hazard_guard guard = domain_.acquire_guard();
                retired_descriptor *desc = guard.protect(seg.current_);
                size_t pos = tagged_position::unpack_pos(seg.dequeue_state_.load(memory_order_acquire));

                if (pos >= desc->capacity_)
                {
                    return false;
                }

                return desc->buffer_[pos].ready_.load(memory_order_acquire);
            }
            else
            {
                size_t pos = seg.dequeue_state_;

                if (pos >= seg.capacity_)
                {
                    return false;
                }

                return seg.buffer_[pos].ready_.load(memory_order_acquire);
            }
        }

        segment *load_consumer_target() const
        {
            if constexpr (MultiConsumer)
            {
                return consumer_target_.load(memory_order_relaxed);
            }
            else
            {
                return consumer_target_;
            }
        }

        void store_consumer_target(segment *s)
        {
            if constexpr (MultiConsumer)
            {
                consumer_target_.store(s, memory_order_relaxed);
            }
            else
            {
                consumer_target_ = s;
            }
        }

        size_t compute_new_capacity(size_t sibling_capacity) const
        {
            size_t grown = (sibling_capacity * growth_numerator_ + growth_denominator_ - 1) / growth_denominator_;
            return grown > sibling_capacity ? grown : sibling_capacity + 1;
        }

        //  Single-consumer only: only ever called once a segment is proven
        //  fully drained, by the sole consumer thread, so there is exactly
        //  one caller and no concurrent reader/writer of buffer_/capacity_
        //  to protect against.
        void retire_and_grow(segment &seg)
        {
            size_t new_capacity = compute_new_capacity(seg.other_->capacity_);

            //  Allocate the new (larger) buffer before freeing the old one,
            //  so an allocator failure degrades to "recycle at the old
            //  capacity" instead of leaving the segment without a buffer.
            slot_type *new_buffer = allocator_traits_type::allocate(allocator_, new_capacity);
            size_t effective_capacity = new_capacity;

            for (size_t i = 0; i < seg.capacity_; ++i)
            {
                allocator_traits_type::destroy(allocator_, &seg.buffer_[i]);
            }

            if (new_buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * new_capacity, alignof(slot_type));
                new_buffer = seg.buffer_;
                effective_capacity = seg.capacity_;
            }
            else
            {
                allocator_traits_type::deallocate(allocator_, seg.buffer_, seg.capacity_);
            }

            for (size_t i = 0; i < effective_capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &new_buffer[i]);
            }

            seg.buffer_ = new_buffer;
            seg.capacity_ = effective_capacity;

            //  Reopen gates: plain buffer_/capacity_ writes above MUST
            //  precede this release-store, since the sole consumer thread's
            //  own next dequeue_state_ read is a plain (non-atomic) read
            //  that simply follows program order, and the producer side's
            //  fetch_add on enqueue_pos_ (acquire) must observe it.
            seg.dequeue_state_ = 0;
            seg.enqueue_pos_.store(0, memory_order_release);
        }

        //  Multi-consumer only: called once `desc` (the descriptor this
        //  thread just finished reading the last position of) is proven
        //  fully drained.  Never mutates `desc` itself -- only ever swaps in
        //  a brand-new descriptor and hands `desc` off to the domain via
        //  retire() -- since other consumer threads may still be mid-call
        //  with a hazard guard protecting `desc`, reading its buffer_/
        //  capacity_ fields (see try_pop_from's "no straggler left" note:
        //  those reads are always stale-but-safe, never a live race,
        //  precisely because those fields never change after construction).
        void retire_and_grow_multi(segment &seg, retired_descriptor *desc)
        {
            typename domain_type::hazard_guard sibling_guard = domain_.acquire_guard();
            retired_descriptor *sibling_desc = sibling_guard.protect(seg.other_->current_);
            size_t new_capacity = compute_new_capacity(sibling_desc->capacity_);

            slot_type *new_buffer = allocator_traits_type::allocate(allocator_, new_capacity);

            if (new_buffer == nullptr)
            {
                MINIMAL_STD_OUT_OF_MEMORY(sizeof(slot_type) * new_capacity, alignof(slot_type));

                //  Recycle at the old capacity: reopen the SAME descriptor
                //  for another life rather than allocating a new one.
                //  `desc`'s buffer_/capacity_ are left completely untouched,
                //  so any thread still holding a hazard-protected reference
                //  to it (see the note above) remains safe regardless of
                //  this reopen.
                uint16_t next_epoch = static_cast<uint16_t>(tagged_position::unpack_epoch(seg.dequeue_state_.load(memory_order_relaxed)) + 1);
                seg.dequeue_state_.store(tagged_position::pack(0, next_epoch), memory_order_release);
                seg.enqueue_pos_.store(0, memory_order_release);
                return;
            }

            for (size_t i = 0; i < new_capacity; ++i)
            {
                allocator_traits_type::construct(allocator_, &new_buffer[i]);
            }

            retired_descriptor *new_desc = new retired_descriptor(domain_, new_buffer, new_capacity, &allocator_);

            //  Reopen gates: the descriptor swap MUST precede these
            //  release-stores, since producers/other consumers gate on
            //  enqueue_pos_/dequeue_state_ (acquire) before trusting
            //  seg.current_ to already reflect this new life.
            seg.current_.store(new_desc, memory_order_release);

            uint16_t next_epoch = static_cast<uint16_t>(tagged_position::unpack_epoch(seg.dequeue_state_.load(memory_order_relaxed)) + 1);
            seg.dequeue_state_.store(tagged_position::pack(0, next_epoch), memory_order_release);
            seg.enqueue_pos_.store(0, memory_order_release);

            //  Hand the old descriptor off for hazard-protected deferred
            //  deletion -- safe to reclaim immediately once no consumer
            //  thread (including this one, whose own guard still protects
            //  it until try_pop_from returns) still holds a hazard pointer
            //  to it.
            desc->retire();
        }

        allocator_type &allocator_;
        size_t growth_numerator_;
        size_t growth_denominator_;
        segment segments_[2];
        atomic<segment *> producer_target_;
        consumer_target_type consumer_target_;
        mutable conditional_t<MultiConsumer, domain_type, no_domain> domain_;
    };
}
