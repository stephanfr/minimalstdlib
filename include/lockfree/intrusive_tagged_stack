#pragma once

#include "minstdconfig.h"

#include "atomic"

#include <stddef.h>

namespace MINIMAL_STD_NAMESPACE
{
    namespace lockfree
    {
        template <typename node_type,
                  typename tagged_ptr_type,
                  typename link_type,
                  link_type node_type::*next_field>
        struct intrusive_tagged_stack
        {
            using storage_type = typename tagged_ptr_type::storage_type;
            using counter_type = typename tagged_ptr_type::counter_type;

            static_assert(sizeof(link_type) == 1 || sizeof(link_type) == 2 || sizeof(link_type) == 4 || sizeof(link_type) == 8,
                          "intrusive_tagged_stack: link_type must be accessible with a single atomic load/store");

            //  The link of a node can be read by a stale popper while its new owner rewrites it.  The tagged CAS on
            //      head discards such stale reads, but the accesses themselves must be atomic to be defined.

            static link_type load_link(const node_type &node) noexcept
            {
                return __atomic_load_n(&(node.*next_field), __ATOMIC_RELAXED);
            }

            static void store_link(node_type &node, link_type link) noexcept
            {
                __atomic_store_n(&(node.*next_field), link, __ATOMIC_RELAXED);
            }

            //  The head word is encoded by a codec: pack(node *, counter), unpack_ptr(), unpack_counter().  The static
            //      overloads use tagged_ptr_type itself (all-static members); a stateful codec such as
            //      arena_tagged_ptr (an arena-relative index instead of a pointer, leaving more bits for the counter)
            //      is passed as an object.  The counter is incremented by every head change and wraps within its
            //      field; it must not wrap while one popper is stalled between its head load and its CAS.

            template <typename adapter_type, typename backoff_type>
            static void push(atomic<storage_type> &head,
                             node_type &node,
                             const adapter_type &adapter,
                             backoff_type &&backoff)
            {
                push(head, node, adapter, backoff, tagged_ptr_type{});
            }

            template <typename adapter_type, typename backoff_type, typename codec_type>
            static void push(atomic<storage_type> &head,
                             node_type &node,
                             const adapter_type &adapter,
                             backoff_type &&backoff,
                             const codec_type &codec)
            {
                using codec_counter_type = typename codec_type::counter_type;

                storage_type current_tag = head.load(memory_order_acquire);
                size_t retries = 0;

                while (true)
                {
                    store_link(node, adapter.to_link(codec.unpack_ptr(current_tag)));

                    storage_type desired_tag = codec.pack(
                        &node,
                        static_cast<codec_counter_type>(codec.unpack_counter(current_tag) + 1));

                    if (head.compare_exchange_strong(
                            current_tag,
                            desired_tag,
                            memory_order_acq_rel,
                            memory_order_acquire))
                    {
                        return;
                    }

                    backoff(retries);
                }
            }

            template <typename adapter_type, typename backoff_type>
            static node_type *pop(atomic<storage_type> &head,
                                  const adapter_type &adapter,
                                  backoff_type &&backoff)
            {
                return pop(head, adapter, backoff, tagged_ptr_type{});
            }

            template <typename adapter_type, typename backoff_type, typename codec_type>
            static node_type *pop(atomic<storage_type> &head,
                                  const adapter_type &adapter,
                                  backoff_type &&backoff,
                                  const codec_type &codec)
            {
                using codec_counter_type = typename codec_type::counter_type;

                storage_type current_tag = head.load(memory_order_acquire);
                size_t retries = 0;

                while (codec.unpack_ptr(current_tag) != nullptr)
                {
                    node_type *current = codec.unpack_ptr(current_tag);

                    storage_type next_tag = codec.pack(adapter.to_node(load_link(*current)),
                                                       static_cast<codec_counter_type>(codec.unpack_counter(current_tag) + 1));

                    if (head.compare_exchange_strong(
                            current_tag,
                            next_tag,
                            memory_order_acq_rel,
                            memory_order_acquire))
                    {
                        store_link(*current, adapter.to_link(nullptr));
                        return current;
                    }

                    backoff(retries);
                }

                return nullptr;
            }

            //  Takes the whole list.  The counter advances like any other head change: resetting it (make(nullptr))
            //      would let a popper that loaded the head before the steal see the same (pointer, counter) again
            //      after a few pushes, and its CAS would install a stale link (ABA).  tlaplus/lockfree_tagged_stack
            static node_type *steal_all(atomic<storage_type> &head)
            {
                return steal_all(head, tagged_ptr_type{});
            }

            template <typename codec_type>
            static node_type *steal_all(atomic<storage_type> &head, const codec_type &codec)
            {
                using codec_counter_type = typename codec_type::counter_type;

                storage_type stolen = head.load(memory_order_acquire);

                while (!head.compare_exchange_weak(
                    stolen,
                    codec.pack(nullptr, static_cast<codec_counter_type>(codec.unpack_counter(stolen) + 1)),
                    memory_order_acq_rel,
                    memory_order_acquire))
                {
                }

                return codec.unpack_ptr(stolen);
            }
        };
    }
}
