        //  Optional, purpose-built notification: implement this to learn when
        //  a hazard_pointer_domain actually reclaims (frees) one or more
        //  retired objects.  Not required for correctness -- the deleter
        //  passed to retire() already performs the real free; this is purely
        //  an informational hook (stats, logging, backpressure monitoring).
        //  Fired once per reclaiming operation (a whole scan() pass, or a
        //  single targeted reclaim), not once per object.
        struct hazard_pointer_reclaim_observer
        {
            virtual void on_reclaimed(size_t reclaimed_this_pass, size_t total_reclaimed) = 0;

        protected:
            ~hazard_pointer_reclaim_observer() = default;
        };

        template <typename T, size_t MAX_HAZARD_POINTERS = 128, size_t MAX_RETIRED_RECORDS = 1024, size_t RETIRE_SCAN_THRESHOLD = 32>
        class hazard_pointer_domain
        {
        private:
            static constexpr size_t INVALID_SLOT_INDEX = numeric_limits<size_t>::max();

            using pointer_type = T *;
            using deleter_type = void (*)(pointer_type);

            struct hazard_record
            {
                minstd::atomic<bool> in_use_{false};
                minstd::atomic<pointer_type> protected_ptr_{nullptr};
            };

            struct retired_record
            {
                minstd::atomic<bool> in_use_{false};
                minstd::atomic<bool> active_{false};

                //  Atomic, not plain: multiple threads can concurrently scan
                //  this record via try_reclaim_specific()/scan() (called
                //  from any hazard guard's release, on any thread), while
                //  another thread may simultaneously be winning the CAS on
                //  active_ above and clearing these two fields. A plain
                //  field would make that a data race -- benign in outcome
                //  (the active_ CAS below still arbitrates who actually
                //  reclaims), but still undefined behavior per the memory
                //  model, and TSan (rightly) flags it.
                minstd::atomic<pointer_type> retired_ptr_{nullptr};
                minstd::atomic<deleter_type> deleter_{nullptr};
            };

        public:
            class hazard_guard
            {
            public:
                hazard_guard() = default;

                hazard_guard(const hazard_guard &) = delete;
                hazard_guard &operator=(const hazard_guard &) = delete;

                hazard_guard(hazard_guard &&other) noexcept
                    : domain_(other.domain_),
                      slot_index_(other.slot_index_)
                {
                    other.domain_ = nullptr;
                    other.slot_index_ = INVALID_SLOT_INDEX;
                }

                hazard_guard &operator=(hazard_guard &&other) noexcept
                {
                    if (this != &other)
                    {
                        release();

                        domain_ = other.domain_;
                        slot_index_ = other.slot_index_;

                        other.domain_ = nullptr;
                        other.slot_index_ = INVALID_SLOT_INDEX;
                    }

                    return *this;
                }

                ~hazard_guard()
                {
                    release();
                }

                bool is_valid() const
                {
                    return (domain_ != nullptr) && (slot_index_ != INVALID_SLOT_INDEX);
                }

                pointer_type protect(const minstd::atomic<pointer_type> &source)
                {
                    if (!is_valid())
                    {
                        return nullptr;
                    }

                    while (true)
                    {
                        pointer_type current = source.load(minstd::memory_order_acquire);
                        domain_->store_hazard(slot_index_, current);

                        if (source.load(minstd::memory_order_acquire) == current)
                        {
                            return current;
                        }
                    }
                }

                void clear()
                {
                    if (!is_valid())
                    {
                        return;
                    }

                    domain_->store_hazard(slot_index_, nullptr);
                }

            private:
                friend class hazard_pointer_domain;

                hazard_guard(hazard_pointer_domain *domain, size_t slot_index)
                    : domain_(domain),
                      slot_index_(slot_index)
                {
                }

                void release()
                {
                    if (!is_valid())
                    {
                        return;
                    }

                    domain_->release_hazard_slot(slot_index_);

                    domain_ = nullptr;
                    slot_index_ = INVALID_SLOT_INDEX;
                }

                hazard_pointer_domain *domain_ = nullptr;
                size_t slot_index_ = INVALID_SLOT_INDEX;
            };

            hazard_pointer_domain() = default;

            explicit hazard_pointer_domain(hazard_pointer_reclaim_observer *observer)
                : observer_(observer)
            {
            }

            hazard_pointer_domain(const hazard_pointer_domain &) = delete;
            hazard_pointer_domain &operator=(const hazard_pointer_domain &) = delete;

            ~hazard_pointer_domain()
            {
                force_reclaim_all();
            }

            hazard_guard acquire_guard()
            {
                return hazard_guard(this, try_acquire_hazard_slot());
            }

            bool retire(pointer_type ptr, deleter_type deleter = default_deleter)
            {
                if (ptr == nullptr)
                {
                    return true;
                }

                for (size_t attempt = 0; attempt < 2; ++attempt)
                {
                    for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                    {
                        bool expected = false;

                        if (!retired_records_[i].in_use_.compare_exchange_strong(expected, true,
                                                                                 minstd::memory_order_acq_rel,
                                                                                 minstd::memory_order_acquire))
                        {
                            continue;
                        }

                        retired_records_[i].retired_ptr_.store(ptr, minstd::memory_order_relaxed);
                        retired_records_[i].deleter_.store(deleter, minstd::memory_order_relaxed);
                        retired_records_[i].active_.store(true, minstd::memory_order_release);

                        //  Primary reclaim path: check this exact pointer right
                        //  now.  Covers the common case where nothing was ever
                        //  protecting it, or whatever was protecting it already
                        //  let go before retire() was even called -- without
                        //  this, such a resource would never get reclaimed,
                        //  since nothing will release a hazard pointer for a
                        //  pointer nobody is holding.
                        try_reclaim_specific(ptr);

                        //  Backstop: an occasional full-table scan in case a
                        //  targeted check was ever missed. Not load-bearing for
                        //  the common case, just defensive.
                        size_t retired_since_scan = retire_since_scan_.fetch_add(1, minstd::memory_order_relaxed) + 1;

                        if (retired_since_scan >= RETIRE_SCAN_THRESHOLD)
                        {
                            scan();
                            retire_since_scan_.store(0, minstd::memory_order_relaxed);
                        }

                        return true;
                    }

                    scan();
                }

                return false;
            }

            //  Targeted reclaim: checks only the retired record matching ptr
            //  (if any) rather than the whole table.  This is the primary
            //  reclaim path -- call it from retire() (to catch resources that
            //  are already unprotected) and whenever a hazard guard releases a
            //  pointer that might match a retired resource (to catch resources
            //  that become unprotected later).  Returns true if this specific
            //  call reclaimed it.
            bool try_reclaim_specific(pointer_type ptr)
            {
                if (ptr == nullptr)
                {
                    return false;
                }

                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].active_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    if (retired_records_[i].retired_ptr_.load(minstd::memory_order_acquire) != ptr)
                    {
                        continue;
                    }

                    if (is_hazard_protected(ptr))
                    {
                        return false;
                    }

                    bool expected = true;

                    if (!retired_records_[i].active_.compare_exchange_strong(expected, false,
                                                                             minstd::memory_order_acq_rel,
                                                                             minstd::memory_order_acquire))
                    {
                        return false;
                    }

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                        notify_reclaimed(1);
                        return true;
                    }

                    return false;
                }

                return false;
            }

            size_t scan()
            {
                size_t reclaimed = 0;

                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].active_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    pointer_type retired_ptr = retired_records_[i].retired_ptr_.load(minstd::memory_order_acquire);

                    if ((retired_ptr == nullptr) || is_hazard_protected(retired_ptr))
                    {
                        continue;
                    }

                    bool expected = true;

                    if (!retired_records_[i].active_.compare_exchange_strong(expected, false,
                                                                             minstd::memory_order_acq_rel,
                                                                             minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                        ++reclaimed;
                    }
                }

                if (reclaimed > 0)
                {
                    notify_reclaimed(reclaimed);
                }

                return reclaimed;
            }

            size_t active_hazard_count() const
            {
                size_t count = 0;

                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    if (hazard_records_[i].protected_ptr_.load(minstd::memory_order_acquire) != nullptr)
                    {
                        ++count;
                    }
                }

                return count;
            }

        private:
            static void default_deleter(pointer_type ptr)
            {
                delete ptr;
            }

            size_t try_acquire_hazard_slot()
            {
                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    bool expected = false;

                    if (hazard_records_[i].in_use_.compare_exchange_strong(expected, true,
                                                                           minstd::memory_order_acq_rel,
                                                                           minstd::memory_order_acquire))
                    {
                        hazard_records_[i].protected_ptr_.store(nullptr, minstd::memory_order_release);
                        return i;
                    }
                }

                return INVALID_SLOT_INDEX;
            }

            void store_hazard(size_t slot_index, pointer_type ptr)
            {
                hazard_records_[slot_index].protected_ptr_.store(ptr, minstd::memory_order_release);
            }

            void release_hazard_slot(size_t slot_index)
            {
                //  Capture what this slot was protecting before clearing it --
                //  if it matches a retired resource, this release may be
                //  exactly the event that makes that resource reclaimable.
                pointer_type released_ptr = hazard_records_[slot_index].protected_ptr_.load(minstd::memory_order_acquire);

                hazard_records_[slot_index].protected_ptr_.store(nullptr, minstd::memory_order_release);
                hazard_records_[slot_index].in_use_.store(false, minstd::memory_order_release);

                if (released_ptr != nullptr)
                {
                    try_reclaim_specific(released_ptr);
                }
            }

            void notify_reclaimed(size_t reclaimed_this_pass)
            {
                if (observer_ != nullptr)
                {
                    size_t total = total_reclaimed_.fetch_add(reclaimed_this_pass, minstd::memory_order_relaxed) + reclaimed_this_pass;
                    observer_->on_reclaimed(reclaimed_this_pass, total);
                }
            }

            bool is_hazard_protected(pointer_type ptr) const
            {
                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    if (!hazard_records_[i].in_use_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    if (hazard_records_[i].protected_ptr_.load(minstd::memory_order_acquire) == ptr)
                    {
                        return true;
                    }
                }

                return false;
            }

            void force_reclaim_all()
            {
                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].in_use_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].active_.store(false, minstd::memory_order_release);
                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                    }
                }
            }

            minstd::array<hazard_record, MAX_HAZARD_POINTERS> hazard_records_{};
            minstd::array<retired_record, MAX_RETIRED_RECORDS> retired_records_{};
            minstd::atomic<size_t> retire_since_scan_{0};
            hazard_pointer_reclaim_observer *observer_ = nullptr;
            minstd::atomic<size_t> total_reclaimed_{0};
        };

        //  Optional CRTP base for a resource type managed by a
        //  hazard_pointer_domain, so callers can write `resource->retire()`
        //  instead of `domain.retire(resource)` -- operating on the resource
        //  itself reads more naturally than operating on the domain through a
        //  pointer/reference, once the resource already exists. (Creation
        //  can't follow the same pattern -- there's no object yet to call a
        //  method on -- so it stays the caller's own responsibility, e.g. a
        //  plain `new Derived(...)`.)
        //
        //  Precondition: the domain must outlive every resource it manages.
        //  If the domain is destroyed first, it force-reclaims (deletes)
        //  every resource still retired with it; any subsequent use of a
        //  dangling resource pointer is a use-after-free -- a loud, immediate
        //  crash, not a subtle one, which is the intended failure mode here
        //  (matching this codebase's other "no concurrent misuse during
        //  teardown" preconditions, e.g. spsc_queue/mpsc_queue).
        template <typename Derived, typename Domain>
        class hazardous_resource
        {
        public:
            void retire()
            {
                domain_->retire(static_cast<Derived *>(this));
            }

        protected:
            explicit hazardous_resource(Domain &domain)
                : domain_(&domain)
            {
            }

            ~hazardous_resource() = default;

        private:
            Domain *domain_;
        };
    }
}
