        //  Optional, purpose-built notification: implement this to learn when
        //  a hazard_pointer_domain actually reclaims (frees) one or more
        //  retired objects.  Not required for correctness -- the deleter
        //  passed to retire() already performs the real free; this is purely
        //  an informational hook (stats, logging, backpressure monitoring).
        //  Fired once per reclaiming operation (a whole scan() pass, or a
        //  single targeted reclaim), not once per object.
        struct hazard_pointer_reclaim_observer
        {
            virtual void on_reclaimed(size_t reclaimed_this_pass, size_t total_reclaimed) = 0;

        protected:
            ~hazard_pointer_reclaim_observer() = default;
        };

        //  A note on ThreadSanitizer:
        //
        //  The protector/reclaimer handshake here is the classic
        //  hazard-pointer store-buffering (Dekker's-algorithm) shape:
        //  the protector does Store(HP[slot]) then Load(source); the
        //  reclaimer does Store(source) [unlink] then Load(HP[slot])
        //  [scan]. Its safety rests on the sequential-consistency TOTAL
        //  ORDER -- the guarantee that at least one of the two loads
        //  observes the other side's store -- which is exactly why every
        //  operation in the handshake is memory_order_seq_cst (see the
        //  extensive comment in hazard_guard::protect()).
        //
        //  TSan's race detector is happens-before based and does NOT model
        //  that seq_cst total order: the protector's HP store and the
        //  reclaimer's scan load touch different locations with no
        //  release/acquire message-passing between them, so TSan cannot
        //  see the ordering edge that makes the pattern safe, and will
        //  occasionally (empirically ~1 run in 150 under heavy
        //  multi-consumer contention) report a spurious use-after-free
        //  between a reclaim free and a protected read.
        //
        //  This was verified to be a TSan modeling artifact, not a real
        //  bug, with a sanitizer-independent experiment: giving the
        //  reclaimed object its own page and mprotect(PROT_NONE)-ing it on
        //  free (never reused, real atomics, real fences) so that any
        //  genuine temporal use-after-free faults immediately. The real
        //  code survived 750 such runs with zero faults, while a
        //  deliberately-broken variant (reclaim ignoring hazards) faulted
        //  ~18% of runs -- confirming the detector works and the real code
        //  has no use-after-free. A TSan suppression for this known
        //  false positive lives in tsan.supp at the repository root.
        template <typename T, size_t MAX_HAZARD_POINTERS = 128, size_t MAX_RETIRED_RECORDS = 1024, size_t RETIRE_SCAN_THRESHOLD = 32>
        class hazard_pointer_domain
        {
        private:
            static constexpr size_t INVALID_SLOT_INDEX = numeric_limits<size_t>::max();
            static constexpr size_t CACHE_LINE_SIZE = 64;

            using pointer_type = T *;
            using deleter_type = void (*)(pointer_type);

            //  Padded to a full cache line: guard acquire/protect/release
            //  each write their slot, and at 16 unpadded bytes four slots
            //  shared one line -- so concurrent guard holders in adjacent
            //  slots false-shared on every operation. One line per slot
            //  costs MAX_HAZARD_POINTERS x 64 bytes per domain (4KB at the
            //  default 64), which is cheap next to eliminating a guaranteed
            //  line bounce per concurrent guard pair.
            struct alignas(CACHE_LINE_SIZE) hazard_record
            {
                minstd::atomic<bool> in_use_{false};
                minstd::atomic<pointer_type> protected_ptr_{nullptr};
            };

            struct retired_record
            {
                minstd::atomic<bool> in_use_{false};
                minstd::atomic<bool> active_{false};

                //  Atomic, not plain: multiple threads can concurrently scan
                //  this record via try_reclaim_specific()/scan() (called
                //  from any hazard guard's release, on any thread), while
                //  another thread may simultaneously be winning the CAS on
                //  active_ above and clearing these two fields. A plain
                //  field would make that a data race -- benign in outcome
                //  (the active_ CAS below still arbitrates who actually
                //  reclaims), but still undefined behavior per the memory
                //  model, and TSan (rightly) flags it.
                minstd::atomic<pointer_type> retired_ptr_{nullptr};
                minstd::atomic<deleter_type> deleter_{nullptr};
            };

        public:
            class hazard_guard
            {
            public:
                hazard_guard() = default;

                hazard_guard(const hazard_guard &) = delete;
                hazard_guard &operator=(const hazard_guard &) = delete;

                hazard_guard(hazard_guard &&other) noexcept
                    : domain_(other.domain_),
                      slot_index_(other.slot_index_)
                {
                    other.domain_ = nullptr;
                    other.slot_index_ = INVALID_SLOT_INDEX;
                }

                hazard_guard &operator=(hazard_guard &&other) noexcept
                {
                    if (this != &other)
                    {
                        release();

                        domain_ = other.domain_;
                        slot_index_ = other.slot_index_;

                        other.domain_ = nullptr;
                        other.slot_index_ = INVALID_SLOT_INDEX;
                    }

                    return *this;
                }

                ~hazard_guard()
                {
                    release();
                }

                bool is_valid() const
                {
                    return (domain_ != nullptr) && (slot_index_ != INVALID_SLOT_INDEX);
                }

                pointer_type protect(const minstd::atomic<pointer_type> &source)
                {
                    if (!is_valid())
                    {
                        return nullptr;
                    }

                    //  Retargeting this slot to a different pointer silently
                    //  drops protection of whatever it held before -- and if
                    //  that previous pointer was retired while we held it,
                    //  our protection is exactly what deferred its reclaim,
                    //  so we owe it the same targeted re-check a full guard
                    //  release performs.  Without this, a retired resource
                    //  whose last protector retargets (rather than releases)
                    //  would sit unreclaimed until the occasional backstop
                    //  scan.  Cheap: with the active-retired-count early-out
                    //  below, the re-check is a single relaxed load when
                    //  nothing is pending reclamation, which is the common
                    //  case.
                    pointer_type previous = domain_->hazard_slot_value(slot_index_);

                    //  Fast path: if this slot already holds a value that a
                    //  fresh read of source still matches, protection has
                    //  been continuous since whenever that value was
                    //  originally stored -- skip the re-store/re-verify.
                    //  Safe regardless of how long ago the store happened:
                    //  the store-then-confirm protocol's safety only
                    //  requires the store to happen-before the confirming
                    //  read (never cleared/changed in between, which holds
                    //  here since this slot has only ever been written by
                    //  this guard), not that the store be freshly made.
                    if (previous != nullptr)
                    {
                        pointer_type current_fast = source.load(minstd::memory_order_seq_cst);

                        if (current_fast == previous)
                        {
                            return current_fast;
                        }
                    }

                    //  seq_cst throughout this store-then-reload -- NOT
                    //  release/acquire -- and paired with an equally
                    //  seq_cst reclaimer scan (is_hazard_protected) and an
                    //  equally seq_cst "unlink" store on the caller's
                    //  source variable (e.g. the ring queue's
                    //  seg.current_.store in retire_and_grow_multi). This
                    //  is the classic hazard-pointer store-buffering (SB)
                    //  / Dekker's-algorithm shape: this thread does
                    //  Store(HP[T]) then Load(source); the reclaiming
                    //  thread does Store(source) [unlink] then Load(HP[T])
                    //  [scan]. Plain release-on-store paired with
                    //  acquire-on-load only synchronizes IF the load
                    //  happens to observe THAT SPECIFIC store -- it gives
                    //  no guarantee that at least ONE of the two loads
                    //  observes the other side's store, which is exactly
                    //  the property this pattern needs (otherwise BOTH
                    //  threads can conclude "the other hasn't acted yet"
                    //  simultaneously). A seq_cst FENCE surrounding a
                    //  release/acquire pair was tried first here and
                    //  measurably narrowed the window (confirmed via
                    //  targeted TSan stress runs) but did not eliminate it
                    //  -- only making the four participating operations
                    //  themselves seq_cst (not just fenced) gives the
                    //  standard's unconditional total-order guarantee for
                    //  this specific pattern. This is more expensive than
                    //  release/acquire, but only on the already-serialized
                    //  multi-consumer retire/reclaim path, not the
                    //  single-consumer fast path.
                    pointer_type current;

                    while (true)
                    {
                        current = source.load(minstd::memory_order_seq_cst);
                        domain_->store_hazard(slot_index_, current);

                        if (source.load(minstd::memory_order_seq_cst) == current)
                        {
                            break;
                        }
                    }

                    if ((previous != nullptr) && (previous != current))
                    {
                        domain_->try_reclaim_specific(previous);
                    }

                    return current;
                }

                void clear()
                {
                    if (!is_valid())
                    {
                        return;
                    }

                    domain_->store_hazard(slot_index_, nullptr);
                }

            private:
                friend class hazard_pointer_domain;

                hazard_guard(hazard_pointer_domain *domain, size_t slot_index)
                    : domain_(domain),
                      slot_index_(slot_index)
                {
                }

                void release()
                {
                    if (!is_valid())
                    {
                        return;
                    }

                    domain_->release_hazard_slot(slot_index_);

                    domain_ = nullptr;
                    slot_index_ = INVALID_SLOT_INDEX;
                }

                hazard_pointer_domain *domain_ = nullptr;
                size_t slot_index_ = INVALID_SLOT_INDEX;
            };

            hazard_pointer_domain() = default;

            explicit hazard_pointer_domain(hazard_pointer_reclaim_observer *observer)
                : observer_(observer)
            {
            }

            hazard_pointer_domain(const hazard_pointer_domain &) = delete;
            hazard_pointer_domain &operator=(const hazard_pointer_domain &) = delete;

            ~hazard_pointer_domain()
            {
                force_reclaim_all();
            }

            hazard_guard acquire_guard()
            {
                return hazard_guard(this, try_acquire_hazard_slot());
            }

            bool retire(pointer_type ptr, deleter_type deleter = default_deleter)
            {
                if (ptr == nullptr)
                {
                    return true;
                }

                for (size_t attempt = 0; attempt < 2; ++attempt)
                {
                    for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                    {
                        //  Test-and-test-and-set: an occupied record costs a
                        //  shared read instead of a failed CAS (which is
                        //  still an exclusive-ownership RMW on the line).
                        if (retired_records_[i].in_use_.load(minstd::memory_order_relaxed))
                        {
                            continue;
                        }

                        bool expected = false;

                        if (!retired_records_[i].in_use_.compare_exchange_strong(expected, true,
                                                                                 minstd::memory_order_acq_rel,
                                                                                 minstd::memory_order_acquire))
                        {
                            continue;
                        }

                        //  Incremented BEFORE active_ goes true, so this
                        //  thread's own subsequent targeted-reclaim calls
                        //  (the primary reclaim path -- see below and the
                        //  guard-release path) are guaranteed by program
                        //  order to see a nonzero count and not early-out
                        //  past their own retirement.  Other threads may
                        //  transiently read a stale zero and skip a check --
                        //  that only defers their (secondary) reclaim
                        //  opportunity to the RETIRE_SCAN_THRESHOLD backstop
                        //  scan, which is already how missed targeted
                        //  reclaims are handled.
                        active_retired_count_.fetch_add(1, minstd::memory_order_relaxed);

                        retired_records_[i].retired_ptr_.store(ptr, minstd::memory_order_relaxed);
                        retired_records_[i].deleter_.store(deleter, minstd::memory_order_relaxed);
                        retired_records_[i].active_.store(true, minstd::memory_order_release);

                        //  Primary reclaim path: check this exact pointer right
                        //  now.  Covers the common case where nothing was ever
                        //  protecting it, or whatever was protecting it already
                        //  let go before retire() was even called -- without
                        //  this, such a resource would never get reclaimed,
                        //  since nothing will release a hazard pointer for a
                        //  pointer nobody is holding.
                        try_reclaim_specific(ptr);

                        //  Backstop: an occasional full-table scan in case a
                        //  targeted check was ever missed. Not load-bearing for
                        //  the common case, just defensive.
                        size_t retired_since_scan = retire_since_scan_.fetch_add(1, minstd::memory_order_relaxed) + 1;

                        if (retired_since_scan >= RETIRE_SCAN_THRESHOLD)
                        {
                            scan();
                            retire_since_scan_.store(0, minstd::memory_order_relaxed);
                        }

                        return true;
                    }

                    scan();
                }

                return false;
            }

            //  Targeted reclaim: checks only the retired record matching ptr
            //  (if any) rather than the whole table.  This is the primary
            //  reclaim path -- call it from retire() (to catch resources that
            //  are already unprotected) and whenever a hazard guard releases a
            //  pointer that might match a retired resource (to catch resources
            //  that become unprotected later).  Returns true if this specific
            //  call reclaimed it.
            bool try_reclaim_specific(pointer_type ptr)
            {
                if (ptr == nullptr)
                {
                    return false;
                }

                //  Fast-path early-out: this is called on EVERY guard
                //  release (and slot retarget), but outside a retirement
                //  window there are zero active retired records -- one
                //  relaxed load spares the full record-table walk in that
                //  common case.  A transiently stale zero here can only
                //  skip a SECONDARY reclaim opportunity (the retiring
                //  thread's own calls are ordered after its increment --
                //  see retire()); anything skipped is picked up by the
                //  threshold backstop scan.
                if (active_retired_count_.load(minstd::memory_order_relaxed) == 0)
                {
                    return false;
                }

                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].active_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    if (retired_records_[i].retired_ptr_.load(minstd::memory_order_acquire) != ptr)
                    {
                        continue;
                    }

                    if (is_hazard_protected(ptr))
                    {
                        return false;
                    }

                    bool expected = true;

                    if (!retired_records_[i].active_.compare_exchange_strong(expected, false,
                                                                             minstd::memory_order_acq_rel,
                                                                             minstd::memory_order_acquire))
                    {
                        return false;
                    }

                    //  Re-verify immediately before committing to delete.
                    //  The single check above and the actual delete are
                    //  separated by this CAS plus the bookkeeping below --
                    //  empirically (via targeted TSan stress hunting) that
                    //  gap is wide enough for a protector's protect() call,
                    //  concurrently in flight against this exact pointer, to
                    //  complete its hazard-slot store in between: the first
                    //  check can observe "unprotected" and a re-check taken
                    //  moments later can observe "protected" for the same
                    //  pointer with nothing else having changed. A single
                    //  check is therefore not sufficient close to the
                    //  delete; the record is put back (still exclusively
                    //  ours, since in_use_ is still true and no other
                    //  retire() call can have touched it) rather than
                    //  deleted, deferring reclaim to the next opportunity
                    //  (another release, or the backstop scan).
                    if (is_hazard_protected(ptr))
                    {
                        retired_records_[i].active_.store(true, minstd::memory_order_release);
                        active_retired_count_.fetch_add(1, minstd::memory_order_relaxed);
                        return false;
                    }

                    active_retired_count_.fetch_sub(1, minstd::memory_order_relaxed);

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                        notify_reclaimed(1);
                        return true;
                    }

                    return false;
                }

                return false;
            }

            size_t scan()
            {
                //  Same early-out as try_reclaim_specific -- see there.
                if (active_retired_count_.load(minstd::memory_order_relaxed) == 0)
                {
                    return 0;
                }

                size_t reclaimed = 0;

                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].active_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    pointer_type retired_ptr = retired_records_[i].retired_ptr_.load(minstd::memory_order_acquire);

                    if ((retired_ptr == nullptr) || is_hazard_protected(retired_ptr))
                    {
                        continue;
                    }

                    bool expected = true;

                    if (!retired_records_[i].active_.compare_exchange_strong(expected, false,
                                                                             minstd::memory_order_acq_rel,
                                                                             minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    //  Re-verify before committing to delete -- see the
                    //  identical re-check in try_reclaim_specific for why a
                    //  single check this far from the actual delete is not
                    //  sufficient.
                    if (is_hazard_protected(retired_ptr))
                    {
                        retired_records_[i].active_.store(true, minstd::memory_order_release);
                        active_retired_count_.fetch_add(1, minstd::memory_order_relaxed);
                        continue;
                    }

                    active_retired_count_.fetch_sub(1, minstd::memory_order_relaxed);

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                        ++reclaimed;
                    }
                }

                if (reclaimed > 0)
                {
                    notify_reclaimed(reclaimed);
                }

                return reclaimed;
            }

            size_t active_hazard_count() const
            {
                size_t count = 0;

                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    if (hazard_records_[i].protected_ptr_.load(minstd::memory_order_acquire) != nullptr)
                    {
                        ++count;
                    }
                }

                return count;
            }

            //  Public wrapper over the internal hazard-table check: true if
            //  ANY hazard slot currently protects ptr.  Intended for owners
            //  that need to safely REUSE (not delete) a resource that was
            //  never retired -- e.g. reopening a buffer in place after an
            //  allocation failure -- by waiting until no reader still holds
            //  it.  Best-effort by nature: a new protector can appear right
            //  after this returns false unless the caller has already made
            //  the resource unreachable to new readers (or those readers
            //  are harmless, e.g. gated out by other state).
            bool is_protected(pointer_type ptr) const
            {
                return is_hazard_protected(ptr);
            }

        private:
            static void default_deleter(pointer_type ptr)
            {
                delete ptr;
            }

            size_t try_acquire_hazard_slot()
            {
                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    //  Test-and-test-and-set: every guard acquisition scans
                    //  from slot 0, so with N concurrent guard holders the
                    //  first N slots are usually taken -- probing them with
                    //  a blind CAS would steal each owner's cache line on
                    //  every acquisition (a failed CAS is still an
                    //  exclusive-ownership RMW), whereas a relaxed load
                    //  leaves the line in Shared state and costs the owner
                    //  nothing.
                    if (hazard_records_[i].in_use_.load(minstd::memory_order_relaxed))
                    {
                        continue;
                    }

                    bool expected = false;

                    if (hazard_records_[i].in_use_.compare_exchange_strong(expected, true,
                                                                           minstd::memory_order_acq_rel,
                                                                           minstd::memory_order_acquire))
                    {
                        //  seq_cst for consistency with every other
                        //  protected_ptr_ access -- see the comment on
                        //  hazard_guard::protect() for why plain
                        //  release/acquire is insufficient for this field.
                        //  Not on the hottest path (once per guard
                        //  acquisition, not per item).
                        hazard_records_[i].protected_ptr_.store(nullptr, minstd::memory_order_seq_cst);
                        return i;
                    }
                }

                return INVALID_SLOT_INDEX;
            }

            pointer_type hazard_slot_value(size_t slot_index) const
            {
                return hazard_records_[slot_index].protected_ptr_.load(minstd::memory_order_seq_cst);
            }

            void store_hazard(size_t slot_index, pointer_type ptr)
            {
                hazard_records_[slot_index].protected_ptr_.store(ptr, minstd::memory_order_seq_cst);
            }

            void release_hazard_slot(size_t slot_index)
            {
                //  Capture what this slot was protecting before clearing it --
                //  if it matches a retired resource, this release may be
                //  exactly the event that makes that resource reclaimable.
                //  seq_cst for consistency with every other protected_ptr_
                //  access -- see the comment on hazard_guard::protect() for
                //  why plain release/acquire is insufficient for this field.
                pointer_type released_ptr = hazard_records_[slot_index].protected_ptr_.load(minstd::memory_order_seq_cst);

                hazard_records_[slot_index].protected_ptr_.store(nullptr, minstd::memory_order_seq_cst);
                hazard_records_[slot_index].in_use_.store(false, minstd::memory_order_release);

                if (released_ptr != nullptr)
                {
                    try_reclaim_specific(released_ptr);
                }
            }

            void notify_reclaimed(size_t reclaimed_this_pass)
            {
                if (observer_ != nullptr)
                {
                    size_t total = total_reclaimed_.fetch_add(reclaimed_this_pass, minstd::memory_order_relaxed) + reclaimed_this_pass;
                    observer_->on_reclaimed(reclaimed_this_pass, total);
                }
            }

            bool is_hazard_protected(pointer_type ptr) const
            {
                //  No in_use_ pre-check needed: a slot's protected_ptr_ is
                //  never left non-null while the slot is free (release
                //  stores null before clearing in_use_; acquisition stores
                //  null before first use), so comparing protected_ptr_
                //  alone is equivalent and halves the atomic loads on this
                //  path -- which runs once per hazard slot per reclaim
                //  check.
                //
                //  seq_cst load: this scan races against a protector's
                //  seq_cst store in hazard_guard::protect() in exactly the
                //  Dekker's-algorithm/store-buffering shape -- see the
                //  extensive comment there. Plain release/acquire on each
                //  side is not sufficient to guarantee at least one of the
                //  two racing operations observes the other; only making
                //  both sides' store and load seq_cst gives the C++
                //  standard's unconditional single-total-order guarantee
                //  for this pattern. (An earlier attempt used an explicit
                //  atomic_thread_fence(seq_cst) here instead -- empirically
                //  it narrowed but did not eliminate the race under TSan,
                //  so this now uses seq_cst directly on the racing
                //  operations rather than fences around weaker ones.)
                for (size_t i = 0; i < MAX_HAZARD_POINTERS; ++i)
                {
                    if (hazard_records_[i].protected_ptr_.load(minstd::memory_order_seq_cst) == ptr)
                    {
                        return true;
                    }
                }

                return false;
            }

            void force_reclaim_all()
            {
                //  Destructor-time only -- no concurrent activity by
                //  precondition, so a plain reset is sufficient.
                active_retired_count_.store(0, minstd::memory_order_relaxed);

                for (size_t i = 0; i < MAX_RETIRED_RECORDS; ++i)
                {
                    if (!retired_records_[i].in_use_.load(minstd::memory_order_acquire))
                    {
                        continue;
                    }

                    pointer_type ptr_to_delete = retired_records_[i].retired_ptr_.load(minstd::memory_order_relaxed);
                    deleter_type deleter = retired_records_[i].deleter_.load(minstd::memory_order_relaxed);

                    retired_records_[i].active_.store(false, minstd::memory_order_release);
                    retired_records_[i].retired_ptr_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].deleter_.store(nullptr, minstd::memory_order_relaxed);
                    retired_records_[i].in_use_.store(false, minstd::memory_order_release);

                    if ((ptr_to_delete != nullptr) && (deleter != nullptr))
                    {
                        deleter(ptr_to_delete);
                    }
                }
            }

            minstd::array<hazard_record, MAX_HAZARD_POINTERS> hazard_records_{};
            minstd::array<retired_record, MAX_RETIRED_RECORDS> retired_records_{};
            minstd::atomic<size_t> retire_since_scan_{0};

            //  Approximate count of records whose active_ flag is set --
            //  maintained solely so the per-guard-release reclaim check can
            //  early-out with one relaxed load when nothing is pending,
            //  instead of walking the whole record table on every release.
            //  See retire()/try_reclaim_specific() for why approximate
            //  (relaxed) counting is sufficient.
            minstd::atomic<size_t> active_retired_count_{0};

            hazard_pointer_reclaim_observer *observer_ = nullptr;
            minstd::atomic<size_t> total_reclaimed_{0};
        };

        //  Optional CRTP base for a resource type managed by a
        //  hazard_pointer_domain, so callers can write `resource->retire()`
        //  instead of `domain.retire(resource)` -- operating on the resource
        //  itself reads more naturally than operating on the domain through a
        //  pointer/reference, once the resource already exists. (Creation
        //  can't follow the same pattern -- there's no object yet to call a
        //  method on -- so it stays the caller's own responsibility, e.g. a
        //  plain `new Derived(...)`.)
        //
        //  Precondition: the domain must outlive every resource it manages.
        //  If the domain is destroyed first, it force-reclaims (deletes)
        //  every resource still retired with it; any subsequent use of a
        //  dangling resource pointer is a use-after-free -- a loud, immediate
        //  crash, not a subtle one, which is the intended failure mode here
        //  (matching this codebase's other "no concurrent misuse during
        //  teardown" preconditions, e.g. spsc_queue/mpsc_queue).
        template <typename Derived, typename Domain>
        class hazardous_resource
        {
        public:
            //  Returns the domain's result: false means the retired-record
            //  table was full and ownership was NOT transferred -- the
            //  caller still owns the object and must dispose of it some
            //  other way (or leak it knowingly).
            bool retire()
            {
                return domain_->retire(static_cast<Derived *>(this));
            }

        protected:
            explicit hazardous_resource(Domain &domain)
                : domain_(&domain)
            {
            }

            ~hazardous_resource() = default;

        private:
            Domain *domain_;
        };
    }
}
